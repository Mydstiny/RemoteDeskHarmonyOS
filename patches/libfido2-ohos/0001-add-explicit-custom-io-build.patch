--- /dev/null
+++ b/src/hid_custom.c
@@ -0,0 +1,24 @@
+/* Copyright 2026 Li Jiong and contributors.
+ * RemoteDesk custom I/O: device access is supplied explicitly by the authorized
+ * application through fido_dev_set_io_functions. No implicit device access.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include "fido.h"
+int fido_hid_manifest(fido_dev_info_t *list, size_t capacity, size_t *count) {
+    (void)list; (void)capacity;
+    if (count == NULL) return FIDO_ERR_INVALID_ARGUMENT;
+    *count = 0; return FIDO_OK;
+}
+void *fido_hid_open(const char *path) { (void)path; return NULL; }
+void fido_hid_close(void *handle) { (void)handle; }
+int fido_hid_read(void *handle, unsigned char *buf, size_t length, int timeout) {
+    (void)handle; (void)buf; (void)length; (void)timeout; return -1;
+}
+int fido_hid_write(void *handle, const unsigned char *buf, size_t length) {
+    (void)handle; (void)buf; (void)length; return -1;
+}
+int fido_hid_set_sigmask(void *handle, const fido_sigset_t *mask) {
+    (void)handle; (void)mask; return FIDO_ERR_UNSUPPORTED_OPTION;
+}
+size_t fido_hid_report_in_len(void *handle) { (void)handle; return 0; }
+size_t fido_hid_report_out_len(void *handle) { (void)handle; return 0; }
