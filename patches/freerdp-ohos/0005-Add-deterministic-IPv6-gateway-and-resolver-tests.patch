+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef FREERDP_LIB_CORE_GATEWAY_IDENTITY_H
+#define FREERDP_LIB_CORE_GATEWAY_IDENTITY_H
+
+#include <freerdp/settings.h>
+
+typedef enum
+{
+	FREERDP_GATEWAY_HOST_TRANSPORT = 0,
+	FREERDP_GATEWAY_HOST_TLS,
+	FREERDP_GATEWAY_HOST_HTTP,
+	FREERDP_GATEWAY_HOST_SPN
+} FREERDP_GATEWAY_HOST_PURPOSE;
+
+static inline const char* freerdp_gateway_hostname_for(const rdpSettings* settings,
+                                                       FREERDP_GATEWAY_HOST_PURPOSE purpose)
+{
+	if (!settings)
+		return nullptr;
+
+	const char* identity = freerdp_settings_get_string(settings, FreeRDP_GatewayHostname);
+	if (purpose != FREERDP_GATEWAY_HOST_TRANSPORT)
+		return identity;
+
+	const char* transport = freerdp_settings_get_string(settings, FreeRDP_GatewayConnectHostname);
+	return (transport && (transport[0] != '\0')) ? transport : identity;
+}
+
+#endif /* FREERDP_LIB_CORE_GATEWAY_IDENTITY_H */
