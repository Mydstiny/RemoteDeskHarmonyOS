index 000000000..1b5062f7b
--- /dev/null
+++ b/libfreerdp/core/test/TestGatewayIpv6Identity.c
@@ -0,0 +1,162 @@
+#include <freerdp/config.h>
+
+#include "../credssp_auth.h"
+#include "../gateway/http.h"
+#include "../gateway/identity.h"
+#include "../gateway/rpc_client.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define TEST_CHECK(_condition)                                                                   \
+	do                                                                                           \
+	{                                                                                            \
+		if (!(_condition))                                                                       \
+		{                                                                                        \
+			(void)fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__, #_condition); \
+			return FALSE;                                                                        \
+		}                                                                                        \
+	} while (0)
+
+static BOOL buffer_contains(const BYTE* buffer, size_t length, const char* expected)
+{
+	if (!buffer || !expected)
+		return FALSE;
+	const size_t expectedLength = strlen(expected);
+	if (expectedLength > length)
+		return FALSE;
+	for (size_t offset = 0; offset <= length - expectedLength; offset++)
+	{
+		if (memcmp(&buffer[offset], expected, expectedLength) == 0)
+			return TRUE;
+	}
+	return FALSE;
+}
+
+static BOOL serialized_host_equals(const char* hostname, const char* expected)
+{
+	BOOL result = FALSE;
+	HttpContext* http = http_context_new();
+	HttpRequest* request = http_request_new();
+	wStream* wire = nullptr;
+	if (!http || !request)
+		goto fail;
+	if (!http_context_set_host(http, hostname) || !http_context_set_pragma(http, "no-cache") ||
+	    !http_context_set_connection(http, "Keep-Alive") ||
+	    !http_request_set_method(request, "GET") || !http_request_set_uri(request, "/") ||
+	    !http_request_set_content_length(request, 0))
+		goto fail;
+	wire = http_request_write(http, request);
+	if (!wire)
+		goto fail;
+	result = buffer_contains(Stream_Buffer(wire), Stream_Length(wire), expected);
+
+fail:
+	Stream_Free(wire, TRUE);
+	http_request_free(request);
+	http_context_free(http);
+	return result;
+}
+
+static BOOL test_gateway_transport_is_separate_from_identity(void)
+{
+	BOOL result = FALSE;
+	rdpSettings* settings = freerdp_settings_new(0);
+	RpcClient* client = nullptr;
+	if (!settings)
+		return FALSE;
+	if (!freerdp_settings_set_string(settings, FreeRDP_GatewayHostname, "gateway.example.test") ||
+	    !freerdp_settings_set_string(settings, FreeRDP_GatewayConnectHostname, "fe80::42%en0") ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_GatewayPort, 443))
+		goto fail;
+
+	const char* transport = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_TRANSPORT);
+	const char* tls = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_TLS);
+	const char* http = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_HTTP);
+	const char* spn = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_SPN);
+	if (!transport || (strcmp(transport, "fe80::42%en0") != 0) || !tls ||
+	    (strcmp(tls, "gateway.example.test") != 0) || !http ||
+	    (strcmp(http, "gateway.example.test") != 0) || !spn ||
+	    (strcmp(spn, "gateway.example.test") != 0))
+		goto fail;
+
+	rdpContext context = WINPR_C_ARRAY_INIT;
+	context.settings = settings;
+	client = rpc_client_new(&context, 4096);
+	if (!client || !client->host || (strcmp(client->host, "fe80::42%en0") != 0) ||
+	    (client->port != 443))
+		goto fail;
+
+	if (!freerdp_settings_set_string(settings, FreeRDP_GatewayConnectHostname, ""))
+		goto fail;
+	transport = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_TRANSPORT);
+	if (!transport || (strcmp(transport, "gateway.example.test") != 0))
+		goto fail;
+	result = TRUE;
+
+fail:
+	rpc_client_free(client);
+	freerdp_settings_free(settings);
+	return result;
+}
+
+static BOOL test_gateway_http_host_uses_identity_authority(void)
+{
+	BOOL identitySerialized = FALSE;
+	rdpSettings* settings = freerdp_settings_new(0);
+	if (!settings)
+		return FALSE;
+	if (freerdp_settings_set_string(settings, FreeRDP_GatewayHostname, "gateway.example.test") &&
+	    freerdp_settings_set_string(settings, FreeRDP_GatewayConnectHostname, "fe80::42%en0"))
+	{
+		const char* http = freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_HTTP);
+		identitySerialized = serialized_host_equals(http, "Host: gateway.example.test\r\n");
+	}
+	freerdp_settings_free(settings);
+	TEST_CHECK(identitySerialized);
+	TEST_CHECK(serialized_host_equals("2001:db8::42", "Host: [2001:db8::42]\r\n"));
+	TEST_CHECK(serialized_host_equals("fe80::42%en0", "Host: [fe80::42%en0]\r\n"));
+	return TRUE;
+}
+
+static BOOL test_gateway_spn_uses_unmodified_identity(void)
+{
+	BOOL result = FALSE;
+	char spn[128] = WINPR_C_ARRAY_INIT;
+	rdpSettings* settings = freerdp_settings_new(0);
+	rdpCredsspAuth* auth = nullptr;
+	if (!settings)
+		return FALSE;
+	if (!freerdp_settings_set_string(settings, FreeRDP_GatewayHostname, "gateway.example.test") ||
+	    !freerdp_settings_set_string(settings, FreeRDP_GatewayConnectHostname, "fe80::42%en0"))
+		goto fail;
+
+	rdpContext context = WINPR_C_ARRAY_INIT;
+	context.settings = settings;
+	auth = credssp_auth_new(&context);
+	if (!auth)
+		goto fail;
+	if (!credssp_auth_set_spn(auth, "HTTP",
+	                          freerdp_gateway_hostname_for(settings, FREERDP_GATEWAY_HOST_SPN)) ||
+	    !credssp_auth_test_get_spn_utf8(auth, spn, ARRAYSIZE(spn)))
+		goto fail;
+	result = strcmp(spn, "HTTP/gateway.example.test") == 0;
+
+fail:
+	credssp_auth_free(auth);
+	freerdp_settings_free(settings);
+	return result;
+}
+
+int TestGatewayIpv6Identity(int argc, char* argv[])
+{
+	WINPR_UNUSED(argc);
+	WINPR_UNUSED(argv);
+	if (!test_gateway_transport_is_separate_from_identity())
+		return -1;
+	if (!test_gateway_http_host_uses_identity_authority())
+		return -1;
+	if (!test_gateway_spn_uses_unmodified_identity())
+		return -1;
+	return 0;
+}
