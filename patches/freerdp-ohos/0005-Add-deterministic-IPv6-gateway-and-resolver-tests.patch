+#if defined(BUILD_TESTING_INTERNAL)
+BOOL credssp_auth_test_get_spn_utf8(const rdpCredsspAuth* auth, char* buffer, size_t size)
+{
+	if (!auth || !auth->spn || !buffer || (size == 0))
+		return FALSE;
+
+#if defined(UNICODE)
+	char* utf8 = ConvertWCharToUtf8Alloc(auth->spn, nullptr);
+	if (!utf8)
+		return FALSE;
+	const int written = snprintf(buffer, size, "%s", utf8);
+	free(utf8);
+#else
+	const int written = snprintf(buffer, size, "%s", auth->spn);
+#endif
+	return (written >= 0) && ((size_t)written < size);
+}
+#endif
