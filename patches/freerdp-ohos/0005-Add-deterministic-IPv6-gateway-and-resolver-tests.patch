+static UINT64 fake_resolver_now(void* userData)
+{
+	return ((FAKE_RESOLVE_STATE*)userData)->now;
+}
+
+static BOOL fake_resolver_cancelled(void* userData)
+{
+	return ((FAKE_RESOLVE_STATE*)userData)->cancelled;
+}
+
+static int fake_resolve(void* userData, const char* hostname, const char* service,
+                        const struct addrinfo* hints, struct addrinfo** result)
+{
+	FAKE_RESOLVE_STATE* state = (FAKE_RESOLVE_STATE*)userData;
+	(void)InterlockedIncrement(&state->resolveCalls);
+	state->argumentsValid = hostname && (strcmp(hostname, "gateway.invalid") == 0) && service &&
+	                        (strcmp(service, "3389") == 0) && hints &&
+	                        (hints->ai_family == AF_UNSPEC) && (hints->ai_socktype == SOCK_STREAM);
+	if (WaitForSingleObject(state->releaseWorker, 5000) != WAIT_OBJECT_0)
+		return EAI_AGAIN;
+
+	struct addrinfo* entry = (struct addrinfo*)calloc(1, sizeof(*entry));
+	struct sockaddr_in6* address = (struct sockaddr_in6*)calloc(1, sizeof(*address));
+	if (!entry || !address)
+	{
+		free(entry);
+		free(address);
+		return EAI_MEMORY;
+	}
+	address->sin6_family = AF_INET6;
+	address->sin6_port = htons(3389);
+	address->sin6_addr.s6_addr[0] = 0x20;
+	address->sin6_addr.s6_addr[1] = 0x01;
+	address->sin6_addr.s6_addr[2] = 0x0d;
+	address->sin6_addr.s6_addr[3] = 0xb8;
+	address->sin6_addr.s6_addr[15] = 0x55;
+	entry->ai_family = AF_INET6;
+	entry->ai_socktype = SOCK_STREAM;
+	entry->ai_protocol = IPPROTO_TCP;
+	entry->ai_addr = (struct sockaddr*)address;
+	entry->ai_addrlen = sizeof(*address);
+	*result = entry;
+	return 0;
+}
+
+static void fake_free_result(void* userData, struct addrinfo* result)
+{
+	FAKE_RESOLVE_STATE* state = (FAKE_RESOLVE_STATE*)userData;
+	if (result)
+	{
+		free(result->ai_addr);
+		free(result);
+	}
+	(void)InterlockedIncrement(&state->freeCalls);
+	(void)SetEvent(state->resultFreed);
+}
+
+static FREERDP_TCP_RESOLVE_TEST_OPS fake_resolver_ops(FAKE_RESOLVE_STATE* state)
+{
+	FREERDP_TCP_RESOLVE_TEST_OPS ops = WINPR_C_ARRAY_INIT;
+	ops.userData = state;
+	ops.now = fake_resolver_now;
+	ops.cancelled = fake_resolver_cancelled;
+	ops.resolve = fake_resolve;
+	ops.freeResult = fake_free_result;
+	return ops;
+}
+
+static BOOL fake_resolver_state_init(FAKE_RESOLVE_STATE* state, BOOL releaseWorker)
+{
+	WINPR_ASSERT(state);
+	ZeroMemory(state, sizeof(*state));
+	state->now = 100;
+	state->releaseWorker = CreateEvent(nullptr, TRUE, releaseWorker, nullptr);
+	state->resultFreed = CreateEvent(nullptr, TRUE, FALSE, nullptr);
+	return state->releaseWorker && state->resultFreed;
+}
+
+static void fake_resolver_state_uninit(FAKE_RESOLVE_STATE* state)
+{
+	if (!state)
+		return;
+	if (state->releaseWorker)
+		(void)CloseHandle(state->releaseWorker);
+	if (state->resultFreed)
+		(void)CloseHandle(state->resultFreed);
+}
