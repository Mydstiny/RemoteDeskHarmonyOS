+static void freerdp_tcp_resolve_state_release(FREERDP_RESOLVE_STATE* state)
+{
+	if (!state || (InterlockedDecrement(&state->references) != 0))
+		return;
+	if (state->result)
+		freeaddrinfo(state->result);
+	free(state->hostname);
+	free(state);
+}
+
+static DWORD freerdp_tcp_resolve_worker(LPVOID argument)
+{
+	FREERDP_RESOLVE_STATE* state = (FREERDP_RESOLVE_STATE*)argument;
+	struct addrinfo hints = WINPR_C_ARRAY_INIT;
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	hints.ai_flags = state->aiFlags;
+	state->status = getaddrinfo(state->hostname, state->service, &hints, &state->result);
+	(void)InterlockedDecrement(&gFreerdpActiveResolvers);
+	freerdp_tcp_resolve_state_release(state);
+	return 0;
+}
+
+static FREERDP_RESOLVE_STATUS freerdp_tcp_resolve_host_bounded(
+    rdpContext* context, const char* hostname, int port, int aiFlags, UINT64 deadline,
+    struct addrinfo** result)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(hostname);
+	WINPR_ASSERT(result);
+	*result = nullptr;
+	if (InterlockedIncrement(&gFreerdpActiveResolvers) > FREERDP_RESOLVE_MAX_WORKERS)
 	{
-		freerdp_set_last_error_if_not(context, FREERDP_ERROR_DNS_NAME_NOT_FOUND);
+		(void)InterlockedDecrement(&gFreerdpActiveResolvers);
+		return FREERDP_RESOLVE_RESOURCE_EXHAUSTED;
+	}
 
-		return FALSE;
+	FREERDP_RESOLVE_STATE* state = (FREERDP_RESOLVE_STATE*)calloc(1, sizeof(*state));
+	if (!state)
+	{
+		(void)InterlockedDecrement(&gFreerdpActiveResolvers);
+		return FREERDP_RESOLVE_RESOURCE_EXHAUSTED;
+	}
+	state->references = 2;
+	state->hostname = _strdup(hostname);
+	state->aiFlags = aiFlags;
+	state->status = EAI_FAIL;
+	if (!state->hostname || (sprintf_s(state->service, sizeof(state->service), "%d", port) < 0))
+	{
+		(void)InterlockedDecrement(&gFreerdpActiveResolvers);
+		freerdp_tcp_resolve_state_release(state);
+		freerdp_tcp_resolve_state_release(state);
+		return FREERDP_RESOLVE_RESOURCE_EXHAUSTED;
 	}
 
-	freerdp_set_last_error_log(context, 0);
-	freeaddrinfo(result);
-	return TRUE;
+	HANDLE thread = CreateThread(nullptr, 0, freerdp_tcp_resolve_worker, state, 0, nullptr);
+	if (!thread)
+	{
+		(void)InterlockedDecrement(&gFreerdpActiveResolvers);
+		freerdp_tcp_resolve_state_release(state);
+		freerdp_tcp_resolve_state_release(state);
+		return FREERDP_RESOLVE_RESOURCE_EXHAUSTED;
+	}
+
+	FREERDP_RESOLVE_STATUS outcome = FREERDP_RESOLVE_FAILED;
+	for (;;)
+	{
+		if (freerdp_shall_disconnect_context(context))
+		{
+			outcome = FREERDP_RESOLVE_CANCELLED;
+			break;
+		}
+		const UINT64 now = GetTickCount64();
+		if ((deadline != UINT64_MAX) && (now >= deadline))
+		{
+			outcome = FREERDP_RESOLVE_TIMED_OUT;
+			break;
+		}
+		DWORD wait = FREERDP_HAPPY_EYEBALLS_CANCEL_SLICE_MS;
+		if (deadline != UINT64_MAX)
+			wait = (DWORD)MIN((UINT64)wait, deadline - now);
+		const DWORD waitStatus = WaitForSingleObject(thread, wait);
+		if (waitStatus == WAIT_OBJECT_0)
+		{
+			if ((state->status == 0) && state->result)
+			{
+				*result = state->result;
+				state->result = nullptr;
+				outcome = FREERDP_RESOLVE_READY;
+			}
+			break;
+		}
+		if (waitStatus != WAIT_TIMEOUT)
+			break;
+	}
+	CloseHandle(thread);
+	freerdp_tcp_resolve_state_release(state);
+	return outcome;
 }
