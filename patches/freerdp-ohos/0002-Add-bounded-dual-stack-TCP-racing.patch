+#if !defined(_WIN32) && defined(WINPR_HAVE_POLL_H)
+typedef struct
+{
+	struct addrinfo* addr;
+	int sockfd;
+	int originalFlags;
+} FREERDP_HAPPY_EYEBALLS_CANDIDATE;
+
+static BOOL freerdp_tcp_addrinfo_allowed(rdpContext* context, const struct addrinfo* addr)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(addr);
+
+	if ((addr->ai_family != AF_INET) && (addr->ai_family != AF_INET6))
+		return FALSE;
+
+	const UINT32 forceIPvX =
+	    freerdp_settings_get_uint32(context->settings, FreeRDP_ForceIPvX);
+	if ((forceIPvX == 4) && (addr->ai_family != AF_INET))
+		return FALSE;
+	if ((forceIPvX == 6) && (addr->ai_family != AF_INET6))
+		return FALSE;
+	return TRUE;
+}
+
+static BOOL freerdp_tcp_addrinfo_equal(const struct addrinfo* first,
+                                       const struct addrinfo* second)
+{
+	WINPR_ASSERT(first);
+	WINPR_ASSERT(second);
+
+	if (first->ai_family != second->ai_family)
+		return FALSE;
+
+	if (first->ai_family == AF_INET)
+	{
+		const struct sockaddr_in* lhs = (const struct sockaddr_in*)first->ai_addr;
+		const struct sockaddr_in* rhs = (const struct sockaddr_in*)second->ai_addr;
+		return (lhs->sin_port == rhs->sin_port) &&
+		       (memcmp(&lhs->sin_addr, &rhs->sin_addr, sizeof(lhs->sin_addr)) == 0);
+	}
+
+	const struct sockaddr_in6* lhs = (const struct sockaddr_in6*)first->ai_addr;
+	const struct sockaddr_in6* rhs = (const struct sockaddr_in6*)second->ai_addr;
+	return (lhs->sin6_port == rhs->sin6_port) && (lhs->sin6_scope_id == rhs->sin6_scope_id) &&
+	       (memcmp(&lhs->sin6_addr, &rhs->sin6_addr, sizeof(lhs->sin6_addr)) == 0);
+}
+
+static size_t freerdp_tcp_interleave_addrinfo(
+    rdpContext* context, struct addrinfo* result,
+    FREERDP_HAPPY_EYEBALLS_CANDIDATE candidates[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES])
+{
+	struct addrinfo* first[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES] = WINPR_C_ARRAY_INIT;
+	struct addrinfo* second[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES] = WINPR_C_ARRAY_INIT;
+	size_t firstCount = 0;
+	size_t secondCount = 0;
+	int firstFamily = AF_UNSPEC;
+
+	for (struct addrinfo* addr = result; addr; addr = addr->ai_next)
+	{
+		if (!freerdp_tcp_addrinfo_allowed(context, addr))
+			continue;
+		if (firstFamily == AF_UNSPEC)
+			firstFamily = addr->ai_family;
+
+		struct addrinfo** family = addr->ai_family == firstFamily ? first : second;
+		size_t* familyCount = addr->ai_family == firstFamily ? &firstCount : &secondCount;
+		if (*familyCount >= FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES)
+			continue;
+
+		BOOL duplicate = FALSE;
+		for (size_t index = 0; index < *familyCount; index++)
+		{
+			if (freerdp_tcp_addrinfo_equal(family[index], addr))
+			{
+				duplicate = TRUE;
+				break;
+			}
+		}
+		if (!duplicate)
+			family[(*familyCount)++] = addr;
+	}
+
+	if ((firstCount == 0) && (secondCount == 0))
+		return 0;
+
+	size_t output = 0;
+	for (size_t index = 0; output < FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES; index++)
+	{
+		BOOL appended = FALSE;
+		if (index < firstCount)
+		{
+			candidates[output].addr = first[index];
+			candidates[output].sockfd = -1;
+			candidates[output].originalFlags = -1;
+			output++;
+			appended = TRUE;
+		}
+		if ((index < secondCount) && (output < FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES))
+		{
+			candidates[output].addr = second[index];
+			candidates[output].sockfd = -1;
+			candidates[output].originalFlags = -1;
+			output++;
+			appended = TRUE;
+		}
+		if (!appended)
+			break;
+	}
+	return output;
+}
+
+static void freerdp_tcp_close_happy_eyeballs_candidates(
+    FREERDP_HAPPY_EYEBALLS_CANDIDATE* candidates, size_t count, int winner)
+{
+	for (size_t index = 0; index < count; index++)
+	{
+		if ((candidates[index].sockfd >= 0) && (candidates[index].sockfd != winner))
+		{
+			close(candidates[index].sockfd);
+			candidates[index].sockfd = -1;
+		}
+	}
+}
+
+static int freerdp_host_connect_happy_eyeballs(rdpContext* context, const char* hostname,
+                                               struct addrinfo* result, UINT64 deadline)
+{
+	FREERDP_HAPPY_EYEBALLS_CANDIDATE
+	    candidates[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES] = WINPR_C_ARRAY_INIT;
+	const size_t candidateCount = freerdp_tcp_interleave_addrinfo(context, result, candidates);
+	if (candidateCount == 0)
+	{
+		freerdp_set_last_error_if_not(context, FREERDP_ERROR_CONNECT_FAILED);
+		return -1;
+	}
+
+	UINT64 nextLaunchAt = GetTickCount64();
+	size_t nextCandidate = 0;
+	size_t activeCount = 0;
+
+	for (;;)
+	{
+		UINT64 now = GetTickCount64();
+		if (freerdp_shall_disconnect_context(context))
+		{
+			freerdp_tcp_close_happy_eyeballs_candidates(candidates, candidateCount, -1);
+			freerdp_set_last_error_if_not(context, FREERDP_ERROR_CONNECT_CANCELLED);
+			return -1;
+		}
+		if ((deadline != UINT64_MAX) && (now >= deadline))
+			break;
+
+		while ((nextCandidate < candidateCount) &&
+		       ((activeCount == 0) || (now >= nextLaunchAt)))
+		{
+			FREERDP_HAPPY_EYEBALLS_CANDIDATE* candidate = &candidates[nextCandidate++];
+			candidate->sockfd = socket(candidate->addr->ai_family, candidate->addr->ai_socktype,
+			                           candidate->addr->ai_protocol);
+			if (candidate->sockfd >= 0)
+			{
+				candidate->originalFlags = fcntl(candidate->sockfd, F_GETFL, 0);
+				if ((candidate->originalFlags < 0) ||
+				    (fcntl(candidate->sockfd, F_SETFL, candidate->originalFlags | O_NONBLOCK) < 0))
+				{
+					close(candidate->sockfd);
+					candidate->sockfd = -1;
+				}
+			}
+
+			if (candidate->sockfd >= 0)
+			{
+				log_connection_address(hostname, candidate->addr);
+				const int status = connect(candidate->sockfd, candidate->addr->ai_addr,
+				                           candidate->addr->ai_addrlen);
+				if (status == 0)
+				{
+					const int winner = candidate->sockfd;
+					if (fcntl(winner, F_SETFL, candidate->originalFlags) < 0)
+					{
+						close(winner);
+						candidate->sockfd = -1;
+						continue;
+					}
+					freerdp_tcp_close_happy_eyeballs_candidates(candidates, candidateCount,
+					                                              winner);
+					return winner;
+				}
+				if ((errno == EINPROGRESS) || (errno == EWOULDBLOCK) || (errno == EALREADY) ||
+				    (errno == EINTR))
+					activeCount++;
+				else
+				{
+					close(candidate->sockfd);
+					candidate->sockfd = -1;
+				}
+			}
+
+			now = GetTickCount64();
+			nextLaunchAt = activeCount > 0 ? now + FREERDP_HAPPY_EYEBALLS_DELAY_MS : now;
+			if (activeCount > 0)
+				break;
+		}
+
+		if ((activeCount == 0) && (nextCandidate >= candidateCount))
+			break;
+
+		struct pollfd pollset[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES] = WINPR_C_ARRAY_INIT;
+		size_t mapping[FREERDP_HAPPY_EYEBALLS_MAX_CANDIDATES] = WINPR_C_ARRAY_INIT;
+		nfds_t pollCount = 0;
+		for (size_t index = 0; index < candidateCount; index++)
+		{
+			if (candidates[index].sockfd < 0)
+				continue;
+			pollset[pollCount].fd = candidates[index].sockfd;
+			pollset[pollCount].events = POLLOUT;
+			mapping[pollCount] = index;
+			pollCount++;
+		}
+
+		now = GetTickCount64();
+		UINT64 waitMs = FREERDP_HAPPY_EYEBALLS_CANCEL_SLICE_MS;
+		if ((nextCandidate < candidateCount) && (nextLaunchAt > now))
+			waitMs = MIN(waitMs, nextLaunchAt - now);
+		if ((deadline != UINT64_MAX) && (deadline > now))
+			waitMs = MIN(waitMs, deadline - now);
+		const int pollTimeout = WINPR_ASSERTING_INT_CAST(int, MIN(waitMs, INT_MAX));
+		const int pollStatus = poll(pollset, pollCount, pollTimeout);
+		if ((pollStatus < 0) && (errno == EINTR))
+			continue;
+		if (pollStatus < 0)
+			break;
+
+		for (nfds_t pollIndex = 0; pollIndex < pollCount; pollIndex++)
+		{
+			if (pollset[pollIndex].revents == 0)
+				continue;
+
+			FREERDP_HAPPY_EYEBALLS_CANDIDATE* candidate = &candidates[mapping[pollIndex]];
+			INT32 socketError = 0;
+			socklen_t errorLength = sizeof(socketError);
+			if ((getsockopt(candidate->sockfd, SOL_SOCKET, SO_ERROR, &socketError, &errorLength) ==
+			     0) &&
+			    (socketError == 0))
+			{
+				const int winner = candidate->sockfd;
+				if (fcntl(winner, F_SETFL, candidate->originalFlags) < 0)
+				{
+					close(winner);
+					candidate->sockfd = -1;
+					activeCount--;
+					continue;
+				}
+				freerdp_tcp_close_happy_eyeballs_candidates(candidates, candidateCount, winner);
+				return winner;
+			}
+
+			close(candidate->sockfd);
+			candidate->sockfd = -1;
+			activeCount--;
+		}
+		if ((activeCount == 0) && (nextCandidate < candidateCount))
+			nextLaunchAt = GetTickCount64();
+	}
+
+	freerdp_tcp_close_happy_eyeballs_candidates(candidates, candidateCount, -1);
+	freerdp_set_last_error_if_not(context, FREERDP_ERROR_CONNECT_FAILED);
+	return -1;
+}
