diff --git a/libfreerdp/core/test/TestTcpHappyEyeballs.c b/libfreerdp/core/test/TestTcpHappyEyeballs.c
new file mode 100644
index 0000000000000000000000000000000000000000..3a966ad37175ecee6f6ae95cb9161cc950048f37
--- /dev/null
+++ b/libfreerdp/core/test/TestTcpHappyEyeballs.c
@@ -0,0 +1,280 @@
+#include <freerdp/config.h>
+
+#include "../tcp.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#define TEST_CHECK(_condition)                                                                   \
+	do                                                                                           \
+	{                                                                                            \
+		if (!(_condition))                                                                       \
+		{                                                                                        \
+			(void)fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__, #_condition); \
+			return FALSE;                                                                        \
+		}                                                                                        \
+	} while (0)
+
+typedef struct
+{
+	UINT64 now;
+	int socketFamilies[32];
+	size_t socketCount;
+	int closed[32];
+	size_t closeCount;
+	size_t pollCalls;
+	BOOL immediateIpv4;
+	BOOL interruptFirstPoll;
+	BOOL completeSecondPoll;
+	BOOL cancelAfterPoll;
+	BOOL cancelAfterRestore;
+	BOOL restored;
+} FAKE_CONNECT_STATE;
+
+typedef struct
+{
+	struct addrinfo entries[20];
+	struct sockaddr_storage addresses[20];
+	size_t count;
+} ADDRESS_CHAIN;
+
+static void address_chain_add(ADDRESS_CHAIN* chain, int family, BYTE suffix)
+{
+	struct addrinfo* entry = &chain->entries[chain->count];
+	struct sockaddr_storage* storage = &chain->addresses[chain->count];
+	ZeroMemory(entry, sizeof(*entry));
+	ZeroMemory(storage, sizeof(*storage));
+	entry->ai_family = family;
+	entry->ai_socktype = SOCK_STREAM;
+	entry->ai_protocol = IPPROTO_TCP;
+	entry->ai_addr = (struct sockaddr*)storage;
+	if (family == AF_INET6)
+	{
+		struct sockaddr_in6* address = (struct sockaddr_in6*)storage;
+		address->sin6_family = AF_INET6;
+		address->sin6_port = htons(3389);
+		address->sin6_addr.s6_addr[0] = 0x20;
+		address->sin6_addr.s6_addr[1] = 0x01;
+		address->sin6_addr.s6_addr[2] = 0x0d;
+		address->sin6_addr.s6_addr[3] = 0xb8;
+		address->sin6_addr.s6_addr[15] = suffix;
+		entry->ai_addrlen = sizeof(*address);
+	}
+	else
+	{
+		struct sockaddr_in* address = (struct sockaddr_in*)storage;
+		address->sin_family = AF_INET;
+		address->sin_port = htons(3389);
+		address->sin_addr.s_addr = htonl(0xC0000200U | suffix);
+		entry->ai_addrlen = sizeof(*address);
+	}
+	if (chain->count > 0)
+		chain->entries[chain->count - 1].ai_next = entry;
+	chain->count++;
+}
+
+static UINT64 fake_now(void* userData)
+{
+	return ((FAKE_CONNECT_STATE*)userData)->now;
+}
+
+static BOOL fake_cancelled(void* userData)
+{
+	const FAKE_CONNECT_STATE* state = (const FAKE_CONNECT_STATE*)userData;
+	return (state->cancelAfterPoll && (state->pollCalls > 0)) ||
+	       (state->cancelAfterRestore && state->restored);
+}
+
+static int fake_socket(void* userData, int domain, WINPR_ATTR_UNUSED int type,
+                       WINPR_ATTR_UNUSED int protocol)
+{
+	FAKE_CONNECT_STATE* state = (FAKE_CONNECT_STATE*)userData;
+	if (state->socketCount >= ARRAYSIZE(state->socketFamilies))
+	{
+		errno = EMFILE;
+		return -1;
+	}
+	state->socketFamilies[state->socketCount] = domain;
+	return 100 + WINPR_ASSERTING_INT_CAST(int, state->socketCount++);
+}
+
+static int fake_get_flags(WINPR_ATTR_UNUSED void* userData, WINPR_ATTR_UNUSED int sockfd)
+{
+	return 0;
+}
+
+static int fake_set_flags(void* userData, WINPR_ATTR_UNUSED int sockfd, int flags)
+{
+	FAKE_CONNECT_STATE* state = (FAKE_CONNECT_STATE*)userData;
+	if (flags == 0)
+		state->restored = TRUE;
+	return 0;
+}
+
+static int fake_connect(void* userData, int sockfd,
+                        WINPR_ATTR_UNUSED const struct sockaddr* address,
+                        WINPR_ATTR_UNUSED socklen_t addressLength)
+{
+	FAKE_CONNECT_STATE* state = (FAKE_CONNECT_STATE*)userData;
+	const size_t index = WINPR_ASSERTING_INT_CAST(size_t, sockfd - 100);
+	if (state->immediateIpv4 && (index < state->socketCount) &&
+	    (state->socketFamilies[index] == AF_INET))
+		return 0;
+	errno = EINPROGRESS;
+	return -1;
+}
+
+static int fake_poll(void* userData, struct pollfd* pollset, nfds_t count, int timeout)
+{
+	FAKE_CONNECT_STATE* state = (FAKE_CONNECT_STATE*)userData;
+	state->pollCalls++;
+	if (state->interruptFirstPoll && (state->pollCalls == 1))
+	{
+		errno = EINTR;
+		return -1;
+	}
+	state->now += WINPR_ASSERTING_INT_CAST(UINT64, MAX(timeout, 0));
+	if (state->completeSecondPoll && (state->pollCalls >= 2) && (count > 0))
+	{
+		pollset[0].revents = POLLOUT;
+		return 1;
+	}
+	return 0;
+}
+
+static int fake_get_socket_error(WINPR_ATTR_UNUSED void* userData, WINPR_ATTR_UNUSED int sockfd,
+                                 INT32* socketError)
+{
+	*socketError = 0;
+	return 0;
+}
+
+static void fake_close(void* userData, int sockfd)
+{
+	FAKE_CONNECT_STATE* state = (FAKE_CONNECT_STATE*)userData;
+	if (state->closeCount < ARRAYSIZE(state->closed))
+		state->closed[state->closeCount++] = sockfd;
+}
+
+static FREERDP_TCP_CONNECT_OPS fake_ops(FAKE_CONNECT_STATE* state)
+{
+	FREERDP_TCP_CONNECT_OPS ops = WINPR_C_ARRAY_INIT;
+	ops.userData = state;
+	ops.now = fake_now;
+	ops.cancelled = fake_cancelled;
+	ops.createSocket = fake_socket;
+	ops.getFlags = fake_get_flags;
+	ops.setFlags = fake_set_flags;
+	ops.connectSocket = fake_connect;
+	ops.pollSockets = fake_poll;
+	ops.getSocketError = fake_get_socket_error;
+	ops.closeSocket = fake_close;
+	return ops;
+}
+
+static BOOL test_late_alternate_and_loser_cleanup(void)
+{
+	ADDRESS_CHAIN chain = WINPR_C_ARRAY_INIT;
+	for (BYTE suffix = 1; suffix <= 17; suffix++)
+		address_chain_add(&chain, AF_INET6, suffix);
+	address_chain_add(&chain, AF_INET, 20);
+
+	FAKE_CONNECT_STATE state = WINPR_C_ARRAY_INIT;
+	state.immediateIpv4 = TRUE;
+	FREERDP_TCP_CONNECT_OPS ops = fake_ops(&state);
+	const int winner = freerdp_tcp_test_happy_eyeballs(chain.entries, 1000, &ops);
+	TEST_CHECK(winner == 101);
+	TEST_CHECK(state.socketCount == 2);
+	TEST_CHECK(state.socketFamilies[0] == AF_INET6);
+	TEST_CHECK(state.socketFamilies[1] == AF_INET);
+	TEST_CHECK(state.closeCount == 1);
+	TEST_CHECK(state.closed[0] == 100);
+	return TRUE;
+}
+
+static BOOL test_deadline_closes_pending_socket(void)
+{
+	ADDRESS_CHAIN chain = WINPR_C_ARRAY_INIT;
+	address_chain_add(&chain, AF_INET6, 1);
+	FAKE_CONNECT_STATE state = WINPR_C_ARRAY_INIT;
+	FREERDP_TCP_CONNECT_OPS ops = fake_ops(&state);
+	TEST_CHECK(freerdp_tcp_test_happy_eyeballs(chain.entries, 120, &ops) < 0);
+	TEST_CHECK(state.now == 120);
+	TEST_CHECK(state.closeCount == 1);
+	TEST_CHECK(state.closed[0] == 100);
+	return TRUE;
+}
+
+static BOOL test_cancel_closes_pending_socket(void)
+{
+	ADDRESS_CHAIN chain = WINPR_C_ARRAY_INIT;
+	address_chain_add(&chain, AF_INET6, 1);
+	FAKE_CONNECT_STATE state = WINPR_C_ARRAY_INIT;
+	state.cancelAfterPoll = TRUE;
+	FREERDP_TCP_CONNECT_OPS ops = fake_ops(&state);
+	TEST_CHECK(freerdp_tcp_test_happy_eyeballs(chain.entries, 1000, &ops) < 0);
+	TEST_CHECK(state.pollCalls == 1);
+	TEST_CHECK(state.closeCount == 1);
+	return TRUE;
+}
+
+static BOOL test_eintr_retries_and_returns_winner(void)
+{
+	ADDRESS_CHAIN chain = WINPR_C_ARRAY_INIT;
+	address_chain_add(&chain, AF_INET6, 1);
+	FAKE_CONNECT_STATE state = WINPR_C_ARRAY_INIT;
+	state.interruptFirstPoll = TRUE;
+	state.completeSecondPoll = TRUE;
+	FREERDP_TCP_CONNECT_OPS ops = fake_ops(&state);
+	TEST_CHECK(freerdp_tcp_test_happy_eyeballs(chain.entries, 1000, &ops) == 100);
+	TEST_CHECK(state.pollCalls == 2);
+	TEST_CHECK(state.closeCount == 0);
+	return TRUE;
+}
+
+static BOOL test_cancel_after_restore_closes_winner(void)
+{
+	ADDRESS_CHAIN chain = WINPR_C_ARRAY_INIT;
+	address_chain_add(&chain, AF_INET, 20);
+	FAKE_CONNECT_STATE state = WINPR_C_ARRAY_INIT;
+	state.immediateIpv4 = TRUE;
+	state.cancelAfterRestore = TRUE;
+	FREERDP_TCP_CONNECT_OPS ops = fake_ops(&state);
+	TEST_CHECK(freerdp_tcp_test_happy_eyeballs(chain.entries, 1000, &ops) < 0);
+	TEST_CHECK(state.closeCount == 1);
+	TEST_CHECK(state.closed[0] == 100);
+	return TRUE;
+}
+
+static BOOL test_resolver_gate_is_bounded(void)
+{
+	size_t acquired = 0;
+	for (; acquired < 8; acquired++)
+		TEST_CHECK(freerdp_tcp_test_resolver_try_acquire());
+	TEST_CHECK(!freerdp_tcp_test_resolver_try_acquire());
+	for (size_t index = 0; index < acquired; index++)
+		freerdp_tcp_test_resolver_release();
+	TEST_CHECK(freerdp_tcp_test_resolver_try_acquire());
+	freerdp_tcp_test_resolver_release();
+	return TRUE;
+}
+
+int TestTcpHappyEyeballs(int argc, char* argv[])
+{
+	WINPR_UNUSED(argc);
+	WINPR_UNUSED(argv);
+	if (!test_late_alternate_and_loser_cleanup())
+		return -1;
+	if (!test_deadline_closes_pending_socket())
+		return -1;
+	if (!test_cancel_closes_pending_socket())
+		return -1;
+	if (!test_eintr_retries_and_returns_winner())
+		return -1;
+	if (!test_cancel_after_restore_closes_winner())
+		return -1;
+	if (!test_resolver_gate_is_bounded())
+		return -1;
+	return 0;
+}
