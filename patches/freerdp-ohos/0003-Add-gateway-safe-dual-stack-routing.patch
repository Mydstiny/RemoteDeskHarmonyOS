diff --git a/libfreerdp/core/gateway/http.c b/libfreerdp/core/gateway/http.c
index b380dd93570f5b6c725927c1b57b04327eed8a59..4b44813e1be4ad3bc429cc048f9aa2031338fac3 100644
--- a/libfreerdp/core/gateway/http.c
+++ b/libfreerdp/core/gateway/http.c
@@ -229,6 +229,13 @@ BOOL http_context_set_host(HttpContext* context, const char* Host)
 	if (!context || !Host)
 		return FALSE;
 
+	/* RFC 3986 requires an IPv6 literal in an HTTP authority to be bracketed.
+	 * GatewayHostname deliberately contains the unbracketed TLS identity, so
+	 * perform the wire-only formatting here instead of contaminating SNI and
+	 * certificate verification with brackets. */
+	if ((Host[0] != '[') && strchr(Host, ':'))
+		return http_context_set_header(context, "Host", "[%s]", Host);
+
 	return http_context_set_header(context, "Host", "%s", Host);
 }
 
