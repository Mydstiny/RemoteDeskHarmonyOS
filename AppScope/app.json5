{
  "app": {
    "bundleName": "com.example.remotedesktop",
    "vendor": "example",
    "versionCode": 1001006,
    "versionName": "1.1.5.1",
    "icon": "$media:layered_image",
    "alternateIcons": [
      { "name": "rd_white", "icon": "$media:rd_logo_white" },
      { "name": "rd_transparent", "icon": "$media:rd_logo_transparent" }
    ],
    "label": "$string:app_name",
    "cloudStructuredDataSyncEnabled": true,
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 1
    }
  }
}
