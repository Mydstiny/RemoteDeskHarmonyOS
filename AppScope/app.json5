{
  "app": {
    "bundleName": "com.example.remotedesktop",
    "vendor": "example",
    "versionCode": 1001007,
    "versionName": "1.1.6",
    "icon": "$media:layered_image",
    "alternateIcons": [
      { "name": "rd_white", "icon": "$media:icon_rd_white" },
      { "name": "rd_transparent", "icon": "$media:icon_rd_clear" },
      { "name": "rd_night", "icon": "$media:icon_rd_night" },
      { "name": "rd_sky", "icon": "$media:icon_rd_sky" },
      { "name": "rd_aurora", "icon": "$media:icon_rd_aurora" },
      { "name": "rd_line", "icon": "$media:icon_rd_line" },
      { "name": "rd_duo", "icon": "$media:icon_rd_duo" },
      { "name": "rd_glass", "icon": "$media:icon_rd_glass" }
    ],
    "label": "$string:app_name",
    "cloudStructuredDataSyncEnabled": true,
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 1
    }
  }
}
