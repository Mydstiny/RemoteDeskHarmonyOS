  private setRdpDriveNamePreference(value: string): void {
    const next: string = normalizeRdpSessionDriveName(value);
    if (next === this.rdpDriveName) { return; }
    this.rdpDriveName = next;
    this.persistSessionPref('rdpDriveName', next);
  }

  private setRdpAuthIdentityModePreference(mode: number): void {
    const next: number = Number.isFinite(mode) ? Math.max(0, Math.min(4, Math.floor(mode))) : 1;
    this.bumpRdpControlCenterSelectionRevision();
    this.rdpAuthIdentityMode = next;
    this.persistSessionPref('rdpAuthIdentityMode', next);
    this.showRdpReconnectPreferenceToast('登录身份格式');
  }

  private setRdpTlsWithoutNlaPreference(enabled: boolean): void {
    if (!enabled) {
      this.rdpTlsWithoutNla = false;
      this.persistSessionPref('rdpTlsWithoutNla', false);
      this.showRdpReconnectPreferenceToast('TLS 兼容登录');
      return;
    }
    promptAction.showDialog({
      title: '启用 TLS 兼容登录？',
      message: '该模式会绕过 NLA，仅应连接你信任且明确关闭了 NLA 的 Windows 主机。',
      buttons: [
        { text: '取消', color: 'rgba(255,255,255,0.7)' },
        { text: '仍然启用', color: '#FF6B6B' }
      ]
    }).then((result: Object): void => {
      const response: Record<string, number> = result as Record<string, number>;
      if (response['index'] !== 1) { return; }
      this.rdpTlsWithoutNla = true;
      this.persistSessionPref('rdpTlsWithoutNla', true);
      this.showRdpReconnectPreferenceToast('TLS 兼容登录');
    }).catch((_error: Error): void => {});
  }

  private openRdpKeyboard(): void {
    this.rdpControlCenterVisible = false;
    if (this.keyboardOpen || this.keyboardImeActive) {
      this.keepKeyboardAfterSheetClose = false;
      this.dismissKeyboard();
    } else {
      this.openKeyboard();
    }
    this.stopRdpDiagnosticsPolling(!this.rdpShowDiagnostics);
  }

  private openRdpShortcutPanel(): void {
    this.rdpControlCenterVisible = false;
    if (!this.handleVisible) {
      this.initHandlePosition();
      this.handleVisible = true;
    }
    this.ensureModifierPanelPositions();
    this.toggleModifierPanel();
    this.stopRdpDiagnosticsPolling(!this.rdpShowDiagnostics);
  }

  private toggleRdpControlCenter(): void {
    this.rdpControlCenterVisible = !this.rdpControlCenterVisible;
    if (this.rdpControlCenterVisible) {
      this.startRdpDiagnosticsPolling();
    } else {
      this.stopRdpDiagnosticsPolling(!this.rdpShowDiagnostics);
    }
  }

  /** Pro AI 助理 in this session: its button in the side bar (or the PC top bar). */
  private sessionAiVisible(): boolean {
    return ProEntries.visible(PRO_DIAGNOSTICS_ASSISTANT_FEATURE, ProAppRuntime.getInstance().context());
  }

  /** The side bar's edge, for the AI's orb to keep clear of: RDP/RustDesk rails on the right, VNC's where it is. */
  private sessionAiAvoidSide(): string {
    if (remoteTopBarLayout(this.isDesktopDevice, this.breakpoint, this.isPadDevice).deviceClass === 'pc') { return ''; }
    if (this.currentProtocolName() === 'vnc') { return this.vncToolbarPreferredSide; }
    return 'right';
  }

  private openSessionAi(): void { this.aiSessionOpenRequest = Date.now(); }

  /** The AI's session actions (session.*), through the same handlers as this session's toolbar. */
  private runSessionAiAction(action: DiagnosticAiAppActionId): boolean {
    // The AI stays up while the connection is down; the session's toolbar actions need it back.
    if (!this.connected && action.startsWith('session.')) {
      promptAction.showToast({ message: '连接已断开，重新连接后再试', duration: 2200 });
      return true;
    }
    if (this.isRustDeskSession()) {
      return runRemoteSessionAiAction(action, this.remoteSessionTopBarActions(), {
        privacyMode: this.rustdeskPrivacyMode, audioEnabled: this.rustdeskAudioEnabled,
        clipboardEnabled: this.rustdeskClipboardEnabled, filePasteEnabled: this.rustdeskFilePasteEnabled,
        imageQuality: this.rustdeskImageQuality, codec: this.rustdeskCodec, showLocalCursor: this.rustdeskShowLocalCursor,
        browseMode: this.rustdeskBrowseMode, relativeMouseMode: this.rustdeskRelativeMouseMode,
        reverseWheel: this.reverseWheelForCurrentProtocol(), swapMouseButtons: this.rustdeskSwapMouseButtons,
        diagnosticsEnabled: this.rustdeskShowDiagnostics
      });
    }
    if (this.isRdpRemoteSession()) {
      switch (action) {
        case 'session.keyboard': this.openRdpKeyboard(); return true;
        case 'session.modifiers': this.openRdpShortcutPanel(); return true;
        case 'session.ctrlAltDel': this.sendCtrlAltDel(); return true;
        case 'session.fileTransfer': this.openFileTransferPanel(); return true;
        case 'session.diagnostics': this.setRdpDiagnosticsPreference(!this.rdpShowDiagnostics); return true;
        case 'session.portrait': this.toggleRemotePortraitDisplay(); return true;
        case 'session.resetCanvas': this.resetCanvasTransformFromMenu(); return true;
        case 'session.disconnect': this.handleRdpToolbarAction('disconnect'); return true;
        default: return false;
      }
    }
    if (this.currentProtocolName() === 'vnc') {
      const vnc: VncSessionToolbarActions = this.vncToolbarActions();
      switch (action) {
        case 'session.keyboard': vnc.onToggleKeyboard(); return true;
        case 'session.modifiers': vnc.onOpenShortcuts(); return true;
        case 'session.diagnostics': vnc.onToggleDiagnostics(); return true;
        case 'session.portrait': vnc.onTogglePortraitDisplay(); return true;
        case 'session.resetCanvas': vnc.onResetCanvas(); return true;
        case 'session.disconnect': vnc.onDisconnect(); return true;
        default: return false;
      }
    }
    return false;
  }

  private handleRdpToolbarAction(action: RdpToolbarAction): void {
    if (action === 'ai') { this.openSessionAi(); return; }
    if (action === 'portrait') { this.toggleRemotePortraitDisplay(); return; }
    if (action === 'control') { this.toggleRdpControlCenter(); return; }
    if (action === 'fileTransfer') { this.openFileTransferPanel(); return; }
    if (action === 'resetCanvas') { this.resetCanvasTransformFromMenu(); return; }
    if (action === 'keyboard') { this.openRdpKeyboard(); return; }
    if (action === 'shortcuts') { this.openRdpShortcutPanel(); return; }
    if (action === 'ctrlAltDel') { this.sendCtrlAltDel(); return; }
    if (action === 'refresh') {
      this.loader.requestFrameRefresh();
      promptAction.showToast({ message: '已请求刷新 RDP 远端画面', duration: 1200 });
      return;
    }
    if (action === 'diagnostics') {
      this.setRdpDiagnosticsPreference(!this.rdpShowDiagnostics);
      return;
    }
    this.disconnectAndCleanup('rdp-session-toolbar-close');
    this.goBack();
  }

  private rdpPerformanceSummary(): RdpSessionPerformanceSummary {
    return rdpSessionPerformanceSummary(this.rdpRenderStats.lastRenderResult,
      this.rdpRenderStats.lastRemoteUpdateAgeMs, this.rdpRenderStats.queueP95Us,
      this.rdpRenderStats.gfxChannelConnected);
  }

  private rdpToolbarAvailableHeight(): number {
    const height: number = this.currentRemoteSessionSidebarViewport().height;
    const insets: RemoteSessionSidebarSystemInsets = this.rdpToolbarSystemInsets(height);
    const top: number = insets.top;
    let bottom: number = Math.max(top, height - insets.bottom);
    if (this.vncToolbarKeyboardRect !== null && this.vncToolbarKeyboardRect.height > 0) {
      bottom = Math.min(bottom, Math.max(top, this.vncToolbarKeyboardRect.y));
    } else if (this.kbHeight > 0) {
      bottom = Math.min(bottom, Math.max(top, height - this.kbHeight));
    }
    const available: number = Math.max(0, bottom - top);
    return this.remotePortraitSidebarHeight(available, available);
  }

  private rdpToolbarTopInset(): number {
    const height: number = this.currentRemoteSessionSidebarViewport().height;
    return this.rdpToolbarSystemInsets(height).top;
  }

  private rdpToolbarSystemInsets(height: number): RemoteSessionSidebarSystemInsets {
    return remoteSessionSidebarSystemInsets(height,
      this.vncToolbarSystemTop, this.vncToolbarSystemBottom);
  }

  private resetCanvasTransformFromMenu(): void {
    if (this.proRdpIncomingId) { this.cancelProRdpIncoming(); }
    this.releaseCanvasPinchInput('canvas-reset-menu');
    this.clearPhysicalPointerCanvasFollow(true);
    this.resetCanvasToDisplayDefault();
    promptAction.showToast({ message: '画面已重新居中', duration: 1200 });
  }

  private openRustDeskDisplayResolutionMenu(): void {
    if (!this.isRustDeskSession() || this.sessionId <= 0) {
      return;
    }
    const capabilities: RustDeskDisplayCapabilities =
      this.loader.getRustDeskDisplayCapabilities(this.sessionId);
    if (!capabilities.supported) {
      promptAction.showToast({ message: '远端尚未提供显示分辨率能力', duration: 1800 });
      return;
    }
    if (capabilities.resolutions.length === 0 && capabilities.displays.length === 0) {
      promptAction.showToast({ message: '远端尚未提供显示器能力', duration: 1800 });
      return;
    }
    this.rustDeskDisplayCapabilities = capabilities;
    this.rustDeskCustomWidthDraft = (capabilities.width > 0 ? capabilities.width : 1920).toString();
    this.rustDeskCustomHeightDraft = (capabilities.height > 0 ? capabilities.height : 1080).toString();
    this.rustDeskCustomVisible = ProEntries.visible(PRO_RUSTDESK_ADVANCED_DISPLAY_FEATURE,
      this.rustDeskAdvancedDisplayContext());
    const support: RustDeskCustomResolutionDecision = this.rustDeskCustomSupport();
    this.rustDeskCustomSupported = support.allowed;
    this.rustDeskCustomSupportDetail = support.allowed ? '' : support.detail;
    this.showRustDeskDisplayResolutionMenu = true;
  }

  private rustDeskAdvancedDisplayContext(): ProAccessContext {
    const context: ProAccessContext = ProAppRuntime.getInstance().context('rustdesk');
    context.capabilities = ['rustdesk.displayControl'];
    return context;
  }

  private rdpAdvancedDisplayVisible(): boolean {
    const context: ProAccessContext = ProAppRuntime.getInstance().context('rdp');
    context.capabilities = ['rdp.displayControl'];
    return ProEntries.visible(PRO_RDP_ADVANCED_DISPLAY_FEATURE, context);
  }

  /** 安全密钥重定向 is shown only to an entitled account on a device whose build carries the channel. */
  private rdpSecurityKeyVisible(): boolean {
    return ProEntries.visible(PRO_SECURITY_KEY_FEATURE, rdpSecurityKeyContext()) && ProRdpSecurityKey.available();
  }

  /** Whether this RDP host redirects a USB security key on this device (local choice AND entitlement). */
  private rdpSecurityKeyRequested(host: RemoteHost): boolean {
    if (host.protocol !== 'rdp' || !ProRdpSecurityKey.available()) { return false; }
    return ProRdpSecurityKeyPreference.enabled(getContext(this) as common.Context,
      AccountSessionCoordinator.getInstance().currentScope().ownerScopeId, host.id);
  }

  private setRdpSecurityKeyPreference(enabled: boolean): void {
    // The switch already shows `enabled`; mirror it first so a refused change is a visible change back.
    this.rdpSecurityKeyEnabled = enabled;
    const host: RemoteHost | null = this.pendingHost;
    const saved: boolean = host !== null && host.protocol === 'rdp' &&
      (!enabled || ProRdpSecurityKey.available()) &&
      ProRdpSecurityKeyPreference.set(getContext(this) as common.Context,
        AccountSessionCoordinator.getInstance().currentScope().ownerScopeId, host.id, enabled);
    if (!saved) {
      const actual: boolean = host !== null && this.rdpSecurityKeyRequested(host);
      setTimeout((): void => { this.rdpSecurityKeyEnabled = actual; }, 0);
      promptAction.showToast({ message: '安全密钥重定向设置未保存，请稍后再试', duration: 2000 });
      return;
    }
    promptAction.showToast({
      message: enabled ? '已开启安全密钥重定向，下次连接生效' : '已关闭安全密钥重定向，下次连接生效',
      duration: 2000
    });
  }

  private startRdpSecurityKey(sessionId: number, reason: string): void {
    this.stopRdpSecurityKey();
    const service: ProRdpSecurityKey = new ProRdpSecurityKey((prompt: RdpSecurityKeyPrompt | null): void => {
      // A stopped or replaced service never touches this page again.
      if (this.rdpSecurityKey === service) { this.applyRdpSecurityKeyPrompt(prompt); }
    });
    service.attachContext(getContext(this) as common.UIAbilityContext);
    this.rdpSecurityKey = service;
    if (service.start(sessionId)) {
      hilog.info(RD_DOMAIN, RD_TAG, 'RDP security key service started reason=' + reason);
    } else {
      this.rdpSecurityKey = null;
      // Expected on restore when the session was connected without redirection.
      hilog.info(RD_DOMAIN, RD_TAG, 'RDP security key: no broker for this session reason=' + reason);
    }
  }

  /** Teardown and handoff: the prompt goes away without handing the keyboard back to the session. */
  private stopRdpSecurityKey(): void {
    const service: ProRdpSecurityKey | null = this.rdpSecurityKey;
    this.rdpSecurityKey = null;
    if (service !== null) { service.stop(); }
    this.rdpSecurityKeyPrompt = null;
  }

  /**
   * A page that adopted a live RDP session (independent PC window, restore) answers its security-key broker. The
   * source page stopped its own service at the handoff; a running service on this page is kept as is.
   */
  private resumeRdpSecurityKeyAfterRestore(): void {
    const host: RemoteHost | null = this.pendingHost;
    if (host === null || host.protocol !== 'rdp' || this.sessionId <= 0) { return; }
    // The switch shows the choice for the next connection; this session keeps what it was connected with.
    this.rdpSecurityKeyEnabled = this.rdpSecurityKeyRequested(host);
    if (this.rdpSecurityKey === null && ProRdpSecurityKey.available()) {
      this.startRdpSecurityKey(this.sessionId, 'restore');
    }
  }

  /**
   * While the security-key prompt is open it owns local input: the keyboard proxy swallows keys (so a PIN never
   * reaches the remote or the log), canForwardInput drops pointer and key input, remote focus is not reclaimed and
   * HarmonyOS shortcuts are not captured. Closing it hands the keyboard back to the remote session.
   */
  private applyRdpSecurityKeyPrompt(prompt: RdpSecurityKeyPrompt | null): void {
    const wasOpen: boolean = this.rdpSecurityKeyPrompt !== null;
    if (prompt !== null && !wasOpen) {
      // Release what the remote believes is held before the prompt starts swallowing key-ups.
      this.releaseAllHeldKeys();
      this.clearRemoteInputFocusSchedule();
    }
    this.rdpSecurityKeyPrompt = prompt;
    if ((prompt !== null) === wasOpen) { return; }
    this.syncHarmonyShortcutCapture(prompt !== null ? 'security-key-prompt-open' : 'security-key-prompt-close');
    if (prompt === null) {
      this.scheduleRemoteInputFocus('security-key-prompt-closed');
    }
  }

  /** What this peer allows, from its version, platform, display index and permission. */
  private rustDeskCustomSupport(): RustDeskCustomResolutionDecision {
    const capabilities: RustDeskDisplayCapabilities = this.rustDeskDisplayCapabilities;
    const capability: RustDeskCustomResolutionCapability = {
      peerVersion: capabilities.peerVersion ?? '',
      platform: (() => {
        const peerPlatform: string = (capabilities.peerPlatform ?? '').trim().toLowerCase();
        if (peerPlatform === 'windows' || peerPlatform.indexOf('windows ') === 0) {
          return 'windows';
        }
        if ((peerPlatform.indexOf('linux') >= 0 && peerPlatform.indexOf('x11') >= 0) ||
            peerPlatform === 'x11') {
          return 'linux_x11';
        }
        return 'unknown';
      })(),
      hasDisplayIndex: capabilities.hasDisplayIndex === true || capabilities.currentDisplay >= 0,
      hasPermission: capabilities.hasPermission === true,
      hasVirtualDisplay: capabilities.hasVirtualDisplay === true
    };
    return rustDeskCustomResolutionDecision(capability);
  }

  private ensureRustDeskAdvancedDisplayEntitled(): boolean {
    const support: RustDeskCustomResolutionDecision = this.rustDeskCustomSupport();
    if (!support.allowed) {
      promptAction.showToast({ message: support.detail, duration: 2200 });
      return false;
    }
    const decision = ProAppRuntime.getInstance().runtime.decision(
      PRO_RUSTDESK_ADVANCED_DISPLAY_FEATURE, this.rustDeskAdvancedDisplayContext());
    if (decision.executable) { return true; }
    promptAction.showToast({
      message: decision.reason === 'purchaseRequired' ? 'RustDesk 自定义远端分辨率需要 Pro' :
        decision.reason === 'planned' ? 'RustDesk 高级显示仍在灰度，当前只开放候选分辨率' : '当前 RustDesk 会话暂不支持自定义显示',
      duration: 2200
    });
    return false;
  }

  private applyRustDeskCustomResolution(widthText: string, heightText: string): void {
    if (!this.ensureRustDeskAdvancedDisplayEntitled()) { return; }
    const checked = this.checkedCustomGeometry(widthText, heightText);
    if (checked === null) { return; }
    this.changeRustDeskDisplayResolution(checked.width, checked.height);
  }

  private changeRustDeskDisplayResolution(width: number, height: number): void {
    const capabilities: RustDeskDisplayCapabilities = this.rustDeskDisplayCapabilities;
    const candidateListed: boolean = capabilities.resolutions.some(
      (item: RustDeskDisplayResolution): boolean => item.width === width && item.height === height);
    if (!candidateListed && !this.ensureRustDeskAdvancedDisplayEntitled()) {
      return;
    }
    if (this.rustDeskDisplaySwitchState.inputBlocked || capabilities.inputBlocked) {
      promptAction.showToast({ message: '显示器仍在切换，请等待切换完成', duration: 1600 });
      return;
    }
    const targetDisplay: number = capabilities.pendingDisplay >= 0
      ? capabilities.pendingDisplay : capabilities.currentDisplay;
    if (!this.loader.changeRustDeskDisplayResolution(this.sessionId, targetDisplay,
      width, height)) {
      promptAction.showToast({ message: '分辨率请求未被远端会话接受', duration: 1800 });
      return;
    }
    this.rustDeskProfileResolutionMode = candidateListed ? 'preset' : 'custom';
    this.rustDeskProfileResolutionPresetId = candidateListed ?
      width.toString() + 'x' + height.toString() : 'custom';
    this.rustDeskProfileResolutionWidth = width;
    this.rustDeskProfileResolutionHeight = height;
    this.rustDeskProfileTargetDisplay = targetDisplay;
    this.rustDeskProfilePendingApply = false;
    this.rustDeskProfileResolutionApplyRequested = false;
    this.persistCurrentRemoteDisplayProfile();
    this.rustDeskDisplayPendingResolution = { width, height };
    this.rustDeskDisplayResolutionPendingSinceMs = Date.now();
    this.showRustDeskDisplayResolutionMenu = false;
    promptAction.showToast({ message: '已请求远端切换为 ' + width.toString() + ' × ' + height.toString(), duration: 1800 });
  }

  private rustDeskDisplayLabel(display: RustDeskDisplayInfo): string {
    return display.name.trim().length > 0 ? display.name : '显示器 ' + (display.display + 1).toString();
  }

  private rustDeskDisplayById(displayId: number,
    displays: RustDeskDisplayInfo[] = this.rustDeskDisplayCapabilities.displays): RustDeskDisplayInfo | null {
    for (const display of displays) {
      if (display.display === displayId) {
        return display;
      }
    }
    return null;
  }

  private selectRustDeskDisplayById(displayId: number): void {
    const display: RustDeskDisplayInfo | null = this.rustDeskDisplayById(displayId);
    if (display === null) {
      promptAction.showToast({ message: '远端显示器列表尚未同步完成', duration: 1600 });
      return;
    }
    this.selectRustDeskDisplay(display);
  }

  private rustDeskDisplayTargetId(): number {
    if (this.rustDeskDisplaySwitchState.inputBlocked &&
      this.rustDeskDisplaySwitchState.pendingDisplay >= 0) {
      return this.rustDeskDisplaySwitchState.pendingDisplay;
    }
    if (this.rustDeskDisplayCapabilities.pendingDisplay >= 0) {
      return this.rustDeskDisplayCapabilities.pendingDisplay;
    }
    return this.rustDeskDisplayCapabilities.currentDisplay;
  }

  private shouldShowRustDeskMultiCanvasPreview(): boolean {
    return this.isDesktopDevice && this.rustdeskMultiCanvasPreviewEnabled &&
      this.isRustDeskSession() && this.rustDeskMultiCanvasPreviewDisplay >= 0;
  }

  private rustDeskPreviewCandidate(
    capabilities: RustDeskDisplayCapabilities = this.rustDeskDisplayCapabilities,
    preferredDisplay: number = -1): RustDeskDisplayInfo | null {
    const decision: RustDeskMultiCanvasPreviewDecision =
      selectRustDeskMultiCanvasPreview(
        this.isDesktopDevice, true, capabilities.currentDisplay,
        preferredDisplay, capabilities.displays);
    return decision.accepted ?
      this.rustDeskDisplayById(decision.display, capabilities.displays) : null;
  }

  private rustDeskPreviewCodec(): number {
    if (this.rustDeskDiagnostics.codec >= 0 && this.rustDeskDiagnostics.codec <= 4) {
      return this.rustDeskDiagnostics.codec;
    }
    const preference: number = this.rustdeskCodec;
    if (preference === 1) { return 2; }
    if (preference === 2) { return 3; }
    if (preference === 3) { return 4; }
    if (preference === 5) { return 1; }
    return 0;
  }

  private rustDeskPreviewDisplayLabel(): string {
    const display: RustDeskDisplayInfo | null =
      this.rustDeskDisplayById(this.rustDeskMultiCanvasPreviewDisplay);
    return display === null ? '显示器' : this.rustDeskDisplayLabel(display);
  }

  private setRustDeskMultiCanvasPreviewEnabled(enabled: boolean): void {
    if (enabled && (!this.isDesktopDevice || !this.isRustDeskSession())) {
      promptAction.showToast({ message: '双画布预览目前仅对 PC RustDesk 会话开放', duration: 2000 });
      return;
    }
    if (enabled) {
      const candidate: RustDeskDisplayInfo | null = this.rustDeskPreviewCandidate();
      if (candidate === null) {
        promptAction.showToast({ message: '没有可用于预览的第二个在线显示器', duration: 1800 });
        return;
      }
      this.rustDeskMultiCanvasPreviewDisplay = candidate.display;
      this.rustdeskMultiCanvasPreviewEnabled = true;
      this.rustDeskMultiCanvasPreview = EMPTY_RUSTDESK_MULTI_CANVAS_PREVIEW;
      promptAction.showToast({ message: '已开启实验性双画布预览（第二画布只读）', duration: 2200 });
      this.pollRustDeskPreviewSurfaceId(0);
      return;
    }
    this.rustdeskMultiCanvasPreviewEnabled = false;
    this.detachRustDeskMultiCanvasPreview('user-disabled');
  }

  private attachRustDeskMultiCanvasPreview(): void {
    if (!this.shouldShowRustDeskMultiCanvasPreview() || this.sessionId <= 0 ||
      this.rustDeskPreviewSurfaceId.length === 0 ||
      this.rustDeskPreviewSurfaceWidthPx <= 0 || this.rustDeskPreviewSurfaceHeightPx <= 0) {
      return;
    }
    const display: RustDeskDisplayInfo | null =
      this.rustDeskDisplayById(this.rustDeskMultiCanvasPreviewDisplay);
    if (display === null || !display.online ||
      display.display === this.rustDeskDisplayCapabilities.currentDisplay) {
      return;
    }
    const sourceWidth: number = display.width > 0 ? display.width : display.originalWidth;
    const sourceHeight: number = display.height > 0 ? display.height : display.originalHeight;
    if (sourceWidth <= 0 || sourceHeight <= 0) {
      return;
    }
    const snapshot: RustDeskMultiCanvasPreviewSnapshot =
      this.loader.attachRustDeskMultiCanvasPreview(
        this.sessionId, display.display, this.rustDeskPreviewSurfaceId,
        this.rustDeskPreviewSurfaceWidthPx, this.rustDeskPreviewSurfaceHeightPx,
        sourceWidth, sourceHeight, this.rustDeskPreviewCodec(),
        this.canvasVisualFlipX, this.canvasVisualFlipY);
    this.rustDeskMultiCanvasPreview = snapshot;
    if (!snapshot.active) {
      promptAction.showToast({
        message: '双画布资源不可用，已保持单画布：' + snapshot.reason,
        duration: 2400
      });
      this.rustdeskMultiCanvasPreviewEnabled = false;
      this.rustDeskMultiCanvasPreviewDisplay = -1;
    }
  }

  private detachRustDeskMultiCanvasPreview(_reason: string): void {
    if (this.rustDeskPreviewSurfacePollTimer >= 0) {
      clearTimeout(this.rustDeskPreviewSurfacePollTimer);
      this.rustDeskPreviewSurfacePollTimer = -1;
    }
    if (this.sessionId > 0) {
      this.loader.detachRustDeskMultiCanvasPreview(this.sessionId, -1);
    }
    this.rustDeskMultiCanvasPreview = EMPTY_RUSTDESK_MULTI_CANVAS_PREVIEW;
    this.rustDeskMultiCanvasPreviewDisplay = -1;
  }

  private syncRustDeskMultiCanvasPreview(previousDisplay: number = -1): void {
    if (!this.rustdeskMultiCanvasPreviewEnabled || !this.isDesktopDevice || this.sessionId <= 0) {
      return;
    }
    const candidate: RustDeskDisplayInfo | null = this.rustDeskPreviewCandidate(
      this.rustDeskDisplayCapabilities, previousDisplay >= 0 ? previousDisplay :
        this.rustDeskMultiCanvasPreviewDisplay);
    if (candidate === null) {
      this.rustdeskMultiCanvasPreviewEnabled = false;
      this.detachRustDeskMultiCanvasPreview('no-online-preview-display');
      promptAction.showToast({ message: '第二显示器已离线，已回退单画布', duration: 2000 });
      return;
    }
    const displayChanged: boolean = candidate.display !== this.rustDeskMultiCanvasPreviewDisplay;
    this.rustDeskMultiCanvasPreviewDisplay = candidate.display;
    if (displayChanged || !this.rustDeskMultiCanvasPreview.active) {
      this.attachRustDeskMultiCanvasPreview();
    } else {
      this.rustDeskMultiCanvasPreview =
        this.loader.getRustDeskMultiCanvasPreview(this.sessionId, candidate.display);
      if (this.rustDeskMultiCanvasPreview.status === 'failed' ||
        this.rustDeskMultiCanvasPreview.status === 'reconfigure_required') {
        this.attachRustDeskMultiCanvasPreview();
      }
    }
  }

  private promoteRustDeskPreviewToInteractive(): void {
    const target: RustDeskDisplayInfo | null =
      this.rustDeskDisplayById(this.rustDeskMultiCanvasPreviewDisplay);
    if (target === null || !target.online || this.rustDeskDisplaySwitchState.inputBlocked) {
      return;
    }
    this.selectRustDeskDisplay(target);
  }

  onRustDeskPreviewSurfaceCreated(surfaceId: string): void {
    this.rustDeskPreviewSurfaceId = surfaceId.trim();
    this.attachRustDeskMultiCanvasPreview();
  }

  onRustDeskPreviewSurfaceDestroyed(_surfaceId: string): void {
    this.rustDeskPreviewSurfaceId = '';
    if (this.sessionId > 0) {
      this.loader.detachRustDeskMultiCanvasPreview(this.sessionId, -1);
    }
    this.rustDeskMultiCanvasPreview = EMPTY_RUSTDESK_MULTI_CANVAS_PREVIEW;
  }

  private pollRustDeskPreviewSurfaceId(attempt: number): void {
    if (!this.shouldShowRustDeskMultiCanvasPreview()) {
      return;
    }
    try {
      const surfaceId: string = this.rustDeskPreviewController.getXComponentSurfaceId();
      if (surfaceId.trim().length > 0) {
        this.onRustDeskPreviewSurfaceCreated(surfaceId);
        return;
      }
    } catch (_e) {
    }
    if (attempt >= 20) {
      this.rustdeskMultiCanvasPreviewEnabled = false;
      this.detachRustDeskMultiCanvasPreview('surface-timeout');
      promptAction.showToast({ message: '第二画布 Surface 未就绪，已回退单画布', duration: 2200 });
      return;
    }
    this.rustDeskPreviewSurfacePollTimer = setTimeout((): void => {
      this.rustDeskPreviewSurfacePollTimer = -1;
      this.pollRustDeskPreviewSurfaceId(attempt + 1);
    }, 50);
  }

  private resetRustDeskInputAfterGeometryChange(reason: string): void {
    // Drop the coalesced move before any release helper can flush it in the
    // old coordinate space. Release controls themselves remain reliable and
    // are queued before the native display-switch barrier.
    this.resetRustDeskPhysicalTouchpadState();
    releaseRustDeskInputForDisplaySwitch({
      discardPendingMouseMove: (): void => this.discardPendingMouseMove(),
      releaseCanvasPinchInput: (): void => this.releaseCanvasPinchInput(reason),
      resetTouchGesture: (): void => this.resetTouchGesture(),
      releaseAllHeldKeys: (): void => this.releaseAllHeldKeys(),
      clearHeldPointerState: (): void => {
        this.touchLeftDown = false;
        this.physicalMouseDownButton = -1;
      },
      resetAllLatches: (): void => this.resetAllLatches(),
      resetTouchpadState: (): void => {
        this.touchpadAnchorValid = false;
        this.resetTouchpadPointerCurve();
      },
      invalidateViewport: (): void => this.invalidateRendererViewportCache()
    });
  }

  private releaseRustDeskInputBeforeBlock(reason: string): void {
    this.discardPendingMouseMove();
    this.releaseCanvasPinchInput(reason);
    this.resetTouchGesture();
    this.releaseAllHeldKeys();
    this.resetAllLatches();
    this.touchpadAnchorValid = false;
    this.resetTouchpadPointerCurve();
  }

  /**
   * End every VNC input sequence in the old framebuffer coordinate space
   * before adopting a DesktopSize/framebuffer update. This prevents a held
   * button or queued move from being replayed against the new geometry.
   */
  private resetVncInputAfterGeometryChange(reason: string): void {
    this.releaseCanvasPinchInput(reason);
    this.releaseAllHeldKeys();
    if (this.touchLeftDown) {
      this.sendMouseNow(this.remoteCursorX, this.remoteCursorY, 0, false);
      this.touchLeftDown = false;
    }
    if (this.physicalMouseDownButton >= 0) {
      this.sendMouseNow(this.remoteCursorX, this.remoteCursorY,
        this.physicalMouseDownButton, false);
      this.physicalMouseDownButton = -1;
    }
    this.resetTouchGesture();
    this.discardPendingMouseMove();
    this.touchpadAnchorValid = false;
    this.resetTouchpadPointerCurve();
    this.invalidateRendererViewportCache();
  }

  /** Release every sequence that was started in the old RDP desktop space. */
  private resetRdpInputAfterGeometryChange(reason: string): void {
    releaseRdpInputForGeometryChange({
      discardPendingMouseMove: (): void => this.discardPendingMouseMove(),
      releaseCanvasPinchInput: (): void => this.releaseCanvasPinchInput(reason),
      releaseAllHeldKeys: (): void => this.releaseAllHeldKeys(),
      releaseHeldPointerState: (): void => {
        if (this.touchLeftDown) {
          this.sendMouseNow(this.remoteCursorX, this.remoteCursorY, 0, false);
          this.touchLeftDown = false;
        }
        if (this.physicalMouseDownButton >= 0) {
          this.sendMouseNow(this.remoteCursorX, this.remoteCursorY,
            this.physicalMouseDownButton, false);
          this.physicalMouseDownButton = -1;
        }
      },
      resetTouchGesture: (): void => this.resetTouchGesture(),
      resetAllLatches: (): void => this.resetAllLatches(),
      resetTouchpadState: (): void => {
        this.touchpadAnchorValid = false;
        this.resetTouchpadPointerCurve();
        this.resetRustDeskPhysicalTouchpadState();
      },
      invalidateViewport: (): void => this.invalidateRendererViewportCache()
    });
  }

  private markRdpGeometryPending(reason: string): void {
    if (!this.isRdpRemoteSession()) {
      return;
    }
    if (this.inputForwardReady) {
      // Release held buttons/keys while the old coordinate space is still
      // authoritative. Once the gate closes, canForwardInput() fails closed.
      this.resetRdpInputAfterGeometryChange(reason);
    }
    const changed: boolean = this.rdpGeometryReady || this.inputForwardReady;
    this.rdpGeometryReady = false;
    this.inputForwardReady = false;
    this.syncHarmonyShortcutCapture('rdp-geometry-pending');
    if (changed) {
      hilog.info(RD_DOMAIN, RD_TAG, 'RDP input geometry pending reason=' + reason +
        ' remote=' + this.remoteWidth.toString() + 'x' + this.remoteHeight.toString() +
        ' requested=' + this.rdpPendingLayoutWidth.toString() + 'x' +
        this.rdpPendingLayoutHeight.toString());
    }
  }

  private refreshRdpInputForwardReadiness(reason: string): void {
    if (!this.isRdpRemoteSession()) {
      return;
    }
    const transition = resolveRdpInputReadinessTransition(
      this.inputForwardReady, this.connected, this.sessionId,
      this.rdpInputStabilityGateReady, this.rdpGeometryReady);
    const ready: boolean = transition.inputReady;
    if (ready === this.inputForwardReady) {
      return;
    }
    this.inputForwardReady = ready;
    this.syncHarmonyShortcutCapture('rdp-input-' + reason);
    hilog.info(RD_DOMAIN, RD_TAG, 'RDP input readiness=' + (ready ? 'ready' : 'blocked') +
      ' reason=' + reason +
      ' stability=' + (this.rdpInputStabilityGateReady ? '1' : '0') +
      ' geometry=' + (this.rdpGeometryReady ? '1' : '0') +
      ' session=' + this.sessionId.toString() +
      ' attempt=' + this.connectAttemptId.toString());
    if (transition.becameReady) {
      this.scheduleRemoteInputFocus('rdp-' + reason);
      this.publishIndependentWindowReady('rdp-' + reason);
    }
  }

  private clearRdpInputStabilityTimer(): void {
    if (this.rdpInputStabilityTimer >= 0) {
      clearTimeout(this.rdpInputStabilityTimer);
      this.rdpInputStabilityTimer = -1;
    }
  }

  private armRdpInputStabilityGate(sessionId: number, attemptId: number,
    delayMs: number = RDP_INPUT_STABILITY_DELAY_MS): void {
    this.clearRdpInputStabilityTimer();
    this.rdpInputStabilityGateReady = delayMs <= 0;
    if (delayMs <= 0) {
      this.refreshRdpInputForwardReadiness('video-stability-gate');
      return;
    }
    this.rdpInputStabilityTimer = setTimeout((): void => {
      this.rdpInputStabilityTimer = -1;
      if (this.sessionId !== sessionId || this.connectAttemptId !== attemptId ||
        !this.connected || !this.isRdpRemoteSession() || this.cleanupStarted ||
        this.remoteDesktopBgFlag || this.sessionWindowBackground) {
        return;
      }
      this.rdpInputStabilityGateReady = true;
      this.refreshRdpInputForwardReadiness('video-stability-gate');
    }, delayMs);
  }

  private applyRustDeskDisplayGeometry(display: RustDeskDisplayInfo): void {
    const width: number = display.width > 0 ? display.width : display.originalWidth;
    const height: number = display.height > 0 ? display.height : display.originalHeight;
    if (width <= 0 || height <= 0) {
      return;
    }
    this.rebaseManualCanvasForSourceGeometry(
      this.remoteWidth, this.remoteHeight, width, height);
    this.updateRemoteSize({
      width,
      height,
      colorDepth: 32,
      multiMonitor: false,
      monitorCount: 1
    });
    this.updateOwnedRemoteSessionPipContentSize(width, height);
    if (!this.canvasTransformGestureModified) {
      this.resetCanvasToDisplayDefault(true);
    } else {
      this.applyCanvasTransform();
    }
    this.requestRemoteCursorViewRefresh(true);
  }

  private selectRustDeskDisplay(display: RustDeskDisplayInfo): void {
    if (!this.isRustDeskSession() || this.sessionId <= 0 || !display.online) {
      return;
    }
    if (!shouldRequestRustDeskDisplaySwitch(
      this.rustDeskDisplaySwitchState,
      display.display,
      this.rustDeskDisplayCapabilities.currentDisplay)) {
      return;
    }
    const outcome = requestRustDeskDisplaySwitch(display.display, Date.now(), {
      releaseInput: (): void =>
        this.resetRustDeskInputAfterGeometryChange('rustdesk-display-switch'),
      requestDisplay: (target: number): RustDeskDisplaySwitchRequest =>
        this.loader.beginRustDeskDisplaySwitch(this.sessionId, target)
    });
    const request: RustDeskDisplaySwitchRequest = outcome.request;
    this.rustDeskDisplaySwitchState = outcome.state;
    if (!request.accepted) {
      promptAction.showToast({ message: '远端显示器切换请求未被接受', duration: 1800 });
      return;
    }

    this.rustDeskProfileTargetDisplay = display.display;
    this.persistCurrentRemoteDisplayProfile();

    this.rustDeskDisplayPendingResolution = EMPTY_RUSTDESK_DISPLAY_RESOLUTION;
    this.rustDeskDisplayResolutionPendingSinceMs = 0;

    promptAction.showToast({
      message: '正在切换到 ' + this.rustDeskDisplayLabel(display),
      duration: 1400
    });
  }

  private syncRustDeskDisplayCatalog(): void {
    if (!this.isRustDeskSession() || this.sessionId <= 0) {
      return;
    }
    const capabilities: RustDeskDisplayCapabilities =
      this.loader.getRustDeskDisplayCapabilities(this.sessionId);
    const nowMs: number = Date.now();
    if (!capabilities.supported ||
      (capabilities.displays.length === 0 && capabilities.resolutions.length === 0)) {
      if (this.rustDeskDisplayPendingResolution.width > 0 &&
        this.rustDeskDisplayResolutionPendingSinceMs > 0 &&
        nowMs - this.rustDeskDisplayResolutionPendingSinceMs >= RUSTDESK_DISPLAY_RESOLUTION_TIMEOUT_MS) {
        this.rustDeskDisplayPendingResolution = EMPTY_RUSTDESK_DISPLAY_RESOLUTION;
        this.rustDeskDisplayResolutionPendingSinceMs = 0;
        promptAction.showToast({ message: '远端分辨率切换未返回确认', duration: 1800 });
      }
      return;
    }
    if (this.rustDeskDisplayPendingResolution.width > 0 &&
      capabilities.width === this.rustDeskDisplayPendingResolution.width &&
      capabilities.height === this.rustDeskDisplayPendingResolution.height) {
      this.rustDeskProfileResolutionWidth = capabilities.width;
      this.rustDeskProfileResolutionHeight = capabilities.height;
      this.rustDeskDisplayPendingResolution = EMPTY_RUSTDESK_DISPLAY_RESOLUTION;
      this.rustDeskDisplayResolutionPendingSinceMs = 0;
      this.rustDeskProfileResolutionApplyRequested = false;
      this.persistCurrentRemoteDisplayProfile();
    } else if (this.rustDeskDisplayPendingResolution.width > 0 &&
      this.rustDeskDisplayResolutionPendingSinceMs > 0 &&
      nowMs - this.rustDeskDisplayResolutionPendingSinceMs >= RUSTDESK_DISPLAY_RESOLUTION_TIMEOUT_MS) {
      this.rustDeskDisplayPendingResolution = EMPTY_RUSTDESK_DISPLAY_RESOLUTION;
      this.rustDeskDisplayResolutionPendingSinceMs = 0;
      promptAction.showToast({ message: '远端分辨率切换未返回确认', duration: 1800 });
    }
    const observation = observeRustDeskDisplaySwitch(
      this.rustDeskDisplaySwitchState,
      {
        currentDisplay: capabilities.currentDisplay,
        readySwitchGeneration: capabilities.readySwitchGeneration,
        pendingDisplay: capabilities.pendingDisplay,
        confirmedDisplay: capabilities.confirmedDisplay,
        inputBlocked: capabilities.inputBlocked
      },
      nowMs,
      RUSTDESK_DISPLAY_SWITCH_TIMEOUT_MS);
    this.rustDeskDisplaySwitchState = observation.state;
    if (observation.notifyTimeout) {
      if (observation.fallbackDisplay >= 0) {
        const fallback: RustDeskDisplayInfo | null =
          this.rustDeskDisplayById(observation.fallbackDisplay, capabilities.displays);
        const rollback = requestRustDeskDisplaySwitch(
          observation.fallbackDisplay, nowMs, {
            releaseInput: (): void =>
              this.resetRustDeskInputAfterGeometryChange('rustdesk-display-switch-timeout'),
            requestDisplay: (target: number): RustDeskDisplaySwitchRequest =>
              this.loader.beginRustDeskDisplaySwitch(this.sessionId, target)
          });
        if (rollback.request.accepted) {
          this.rustDeskDisplaySwitchState = rollback.state;
          promptAction.showToast({
            message: '显示器切换超时，正在回退到 ' +
              (fallback === null ? '上一个显示器' : this.rustDeskDisplayLabel(fallback)),
            duration: 2200
          });
        } else {
          promptAction.showToast({
            message: '显示器切换超时，自动回退请求未被接受，输入保持暂停',
            duration: 2400
          });
        }
      } else {
        promptAction.showToast({
          message: '显示器切换超时，尚无可回退的已确认显示器，输入保持暂停',
          duration: 2400
        });
      }
    }
    if (!observation.adoptCapabilities) {
      return;
    }
    const previous: RustDeskDisplayCapabilities = this.rustDeskDisplayCapabilities;
    const epochChanged: boolean = this.rustDeskGeometryEpoch > 0 && capabilities.geometryEpoch > 0 &&
      this.rustDeskGeometryEpoch !== capabilities.geometryEpoch;
    const currentChanged: boolean = previous.currentDisplay !== capabilities.currentDisplay ||
      previous.width !== capabilities.width || previous.height !== capabilities.height ||
      previous.geometryEpoch !== capabilities.geometryEpoch || epochChanged;
    if (currentChanged && previous.width > 0 && previous.height > 0) {
      this.resetRustDeskInputAfterGeometryChange('rustdesk-geometry-epoch');
    }
    this.rustDeskDisplayCapabilities = capabilities;
    this.rustDeskGeometryEpoch = capabilities.geometryEpoch;
    if (currentChanged) {
      const current = this.rustDeskDisplayById(capabilities.currentDisplay, capabilities.displays);
      if (current !== null) {
        this.applyRustDeskDisplayGeometry(current);
        if (previous.currentDisplay !== capabilities.currentDisplay) {
          promptAction.showToast({
            message: '已切换到 ' + this.rustDeskDisplayLabel(current),
            duration: 1400
          });
        }
      }
    }
    this.syncRustDeskMultiCanvasPreview(
      previous.currentDisplay !== capabilities.currentDisplay ? previous.currentDisplay : -1);
    this.applyPendingRustDeskDisplayProfile();
  }

  private applyPendingRustDeskDisplayProfile(): void {
    if (!this.rustDeskProfilePendingApply || !this.isRustDeskSession() || this.sessionId <= 0 ||
      !this.rustDeskDisplayCapabilities.supported) {
      return;
    }
    const capabilities: RustDeskDisplayCapabilities = this.rustDeskDisplayCapabilities;
    if (this.rustDeskProfileTargetDisplay >= 0 &&
      capabilities.currentDisplay !== this.rustDeskProfileTargetDisplay) {
      const target: RustDeskDisplayInfo | null = this.rustDeskDisplayById(
        this.rustDeskProfileTargetDisplay, capabilities.displays);
      if (target === null || !target.online) {
        this.rustDeskProfilePendingApply = false;
        return;
      }
      this.selectRustDeskDisplay(target);
      return;
    }
    if (this.rustDeskProfileResolutionMode === 'auto' ||
      this.rustDeskProfileResolutionWidth <= 0 || this.rustDeskProfileResolutionHeight <= 0) {
      this.rustDeskProfilePendingApply = false;
      this.persistCurrentRemoteDisplayProfile();
      return;
    }
    if (capabilities.width === this.rustDeskProfileResolutionWidth &&
      capabilities.height === this.rustDeskProfileResolutionHeight) {
      this.rustDeskProfilePendingApply = false;
      this.rustDeskProfileResolutionApplyRequested = false;
      this.persistCurrentRemoteDisplayProfile();
      return;
    }
    if (this.rustDeskProfileResolutionApplyRequested ||
      this.rustDeskDisplaySwitchState.inputBlocked || capabilities.inputBlocked) {
      return;
    }
    const listed: boolean = capabilities.resolutions.some(
      (item: RustDeskDisplayResolution): boolean =>
        item.width === this.rustDeskProfileResolutionWidth &&
        item.height === this.rustDeskProfileResolutionHeight);
    if (!listed) {
      const support: RustDeskCustomResolutionDecision = this.rustDeskCustomSupport();
      const decision: ProAccessDecision = ProAppRuntime.getInstance().runtime.decision(
        PRO_RUSTDESK_ADVANCED_DISPLAY_FEATURE, this.rustDeskAdvancedDisplayContext());
      if (!support.allowed || !decision.executable) {
        // Keep the stored request for a future supported peer, but never send
        // a custom request without explicit peer permission and Pro access.
        this.rustDeskProfilePendingApply = false;
        return;
      }
    }
    const targetDisplay: number = capabilities.currentDisplay;
    if (!this.loader.changeRustDeskDisplayResolution(this.sessionId, targetDisplay,
      this.rustDeskProfileResolutionWidth, this.rustDeskProfileResolutionHeight)) {
      this.rustDeskProfilePendingApply = false;
      return;
    }
    this.rustDeskProfileResolutionApplyRequested = true;
    this.rustDeskDisplayPendingResolution = {
      width: this.rustDeskProfileResolutionWidth,
      height: this.rustDeskProfileResolutionHeight
    };
    this.rustDeskDisplayResolutionPendingSinceMs = Date.now();
  }

  private isRustDeskDisplayResolutionSelected(resolution: RustDeskDisplayResolution): boolean {
    if (this.rustDeskDisplayPendingResolution.width > 0 &&
      this.rustDeskDisplayPendingResolution.height > 0) {
      return resolution.width === this.rustDeskDisplayPendingResolution.width &&
        resolution.height === this.rustDeskDisplayPendingResolution.height;
    }
    return resolution.width === this.rustDeskDisplayCapabilities.width &&
      resolution.height === this.rustDeskDisplayCapabilities.height;
  }

  private rustDeskDisplayResolutionStatusLabel(): string {
    if (this.rustDeskDisplayPendingResolution.width > 0 &&
      this.rustDeskDisplayPendingResolution.height > 0) {
      return '待应用：' + this.rustDeskDisplayPendingResolution.width.toString() + ' × ' +
        this.rustDeskDisplayPendingResolution.height.toString();
    }
    return this.rustDeskDisplayCapabilities.width.toString() + ' × ' +
      this.rustDeskDisplayCapabilities.height.toString();
  }

  private refreshCanvasViewportSnapshot(forceRendererRead: boolean = false): CanvasViewport {
    let sourceWidth: number = this.rendererSourceWidth > 0 ? this.rendererSourceWidth : this.remoteWidth;
    let sourceHeight: number = this.rendererSourceHeight > 0 ? this.rendererSourceHeight : this.remoteHeight;
    if (forceRendererRead) {
      const viewport: RendererViewportSnapshot | null = this.readRendererViewport(true);
      if (viewport !== null && viewport.sourceWidth > 0 && viewport.sourceHeight > 0) {
        sourceWidth = viewport.sourceWidth;
        sourceHeight = viewport.sourceHeight;
      }
    }
    const snapshot: CanvasViewport = {
      surfaceWidth: this.renderWidthPx > 0 ? this.renderWidthPx : this.vpToPx(this.surfaceWidth),
      surfaceHeight: this.renderHeightPx > 0 ? this.renderHeightPx : this.vpToPx(this.surfaceHeight),
      sourceWidth: Math.max(1, sourceWidth),
      sourceHeight: Math.max(1, sourceHeight),
      freePanInsetRatio: this.currentCanvasFreePanInsetRatio()
    };
    this.canvasViewportSnapshot = snapshot;
    this.canvasViewportSnapshotHandle = this.rendererHandle;
    return snapshot;
  }

  private currentCanvasViewport(forceRendererRead: boolean = false): CanvasViewport {
    if (!forceRendererRead && this.canvasViewportSnapshot !== null &&
      this.canvasViewportSnapshotHandle === this.rendererHandle) {
      return this.canvasViewportSnapshot;
    }
    return this.refreshCanvasViewportSnapshot(forceRendererRead);
  }

  private currentCanvasFreePanInsetRatio(): number {
    return this.isRdpRemoteSession() && !this.remotePortraitDisplayActiveForCurrentProtocol() ?
      RDP_CANVAS_FREE_PAN_INSET_RATIO : 0;
  }

  private resetCanvasToDisplayDefault(forceRendererRead: boolean = false): void {
    const viewport: CanvasViewport = this.currentCanvasViewport(forceRendererRead);
    this.canvasTransform = this.currentCanvasDisplayDefault(viewport);
    this.canvasTransformInitialized = true;
    this.canvasTransformGestureModified = false;
    this.applyCanvasTransform();
  }

  private currentCanvasDisplayDefault(viewport: CanvasViewport): CanvasTransform {
    let mode: LocalViewScaleMode = normalizeLocalViewScaleMode(this.remoteDisplayScaleMode);
    let customScalePercent: number = this.remoteDisplayCustomScalePercent;
    if (this.isVncSession()) {
      mode = this.vncDisplayScaleMode === '100' || this.vncDisplayScaleMode === 'custom' ?
        this.vncDisplayScaleMode : 'fit';
      customScalePercent = this.vncCustomScalePercent;
      if (this.vncDisplayScaleMode === 'integer') {
        const fit: number = Math.min(viewport.surfaceWidth / viewport.sourceWidth,
          viewport.surfaceHeight / viewport.sourceHeight);
        if (Number.isFinite(fit) && fit >= 1) {
          mode = 'custom';
          customScalePercent = Math.max(100, Math.floor(fit) * 100);
        }
      }
    }
    return baseCanvasTransform(mode, customScalePercent, viewport,
      this.canvasRotationQuarterTurns);
  }

  private refreshCanvasTransformModified(viewport: CanvasViewport): void {
    this.canvasTransformGestureModified = canvasTransformDiffersFromBaseline(
      this.canvasTransform, this.currentCanvasDisplayDefault(viewport));
  }

  private applyCanvasTransform(): void {
    if (this.rendererHandle <= 0) {
      return;
    }
    const viewport: CanvasViewport = this.currentCanvasViewport();
    this.canvasTransform = clampCanvasTransform(this.canvasTransform, viewport);
    this.canvasRotationQuarterTurns = this.canvasTransform.rotation ?? 0;
    const submittedVersion: number = this.loader.setRendererCanvasTransform(this.rendererHandle,
      this.canvasTransform.scale,
      this.canvasTransform.panX, this.canvasTransform.panY,
      this.canvasRotationQuarterTurns, this.canvasVisualFlipX, this.canvasVisualFlipY);
    if (Number.isFinite(submittedVersion) && submittedVersion > 0) {
      this.rendererCanvasTransformPendingVersion = submittedVersion;
    }
    // Keep coordinate mapping responsive while native redraw catches up. The
    // calculation mirrors GLRenderer::CalculateViewport and avoids a NAPI
    // read on every pinch update.
    this.updateRendererViewportCacheForCanvasTransform(viewport);
  }

  private captureRustDeskOrientation(observation: number = 0, source: number = 0): void {
    if (this.currentProtocolName() !== 'rustdesk' || this.sessionId <= 0) { return; }
    try {
      const snapshot = this.loader.getRustDeskDiagnostics(this.sessionId);
      const recorded: boolean = recordVideoOrientation('rustdesk', this.sessionId,
        diagnosticDesktopRuntimeFacts('connection.rustdesk', snapshot,
          AppStorage.get<number>('rustdeskCodec') ?? 0),
        this.canvasControlFlipX, this.canvasControlFlipY, source, observation,
        this.canvasVisualFlipX ? 1 : 0, this.canvasVisualFlipY ? 1 : 0,
        this.rendererCanvasTransformPendingVersion);
      if (observation > 0) {
        promptAction.showToast({ message: recorded ? '画面状态已写入抓取日志' : '请先开启 RustDesk 日志抓取' });
      }
    } catch (_err) {}
  }

  private adoptRustDeskDesktopFlipMode(mode: RustDeskDesktopFlipMode,
    reason: string, preserveCanvasFocus: boolean): void {
    const normalized: RustDeskDesktopFlipMode = normalizeRustDeskDesktopFlipMode(mode);
    const state: RustDeskDesktopFlipState = rustDeskDesktopFlipState(normalized);
    const pan: RustDeskDesktopFlipPan = preserveCanvasFocus ?
      reprojectRustDeskDesktopFlipPan(this.rustDeskDesktopFlipMode, normalized,
        this.canvasTransform.panX, this.canvasTransform.panY) :
      { panX: 0, panY: 0 };
    this.rustDeskDesktopFlipMode = normalized;
    this.canvasRotationQuarterTurns = 0;
    this.canvasControlRotationQuarterTurns = 0;
    this.canvasVisualFlipX = state.visualFlipX;
    this.canvasVisualFlipY = state.visualFlipY;
    this.canvasControlFlipX = state.controlFlipX;
    this.canvasControlFlipY = state.controlFlipY;
    this.canvasTransform = {
      scale: this.canvasTransform.scale,
      panX: pan.panX,
      panY: pan.panY,
      rotation: 0
    };
    if (this.rendererHandle > 0) {
      this.applyCanvasTransform();
      this.syncRustDeskMultiCanvasPreviewVisualTransform(reason);
      this.requestRemoteCursorViewRefresh(true);
      this.syncRemoteSystemPointer('rustdesk-desktop-flip-' + reason,
        this.remoteSurfaceHovered !== false, true);
    }
    this.captureRustDeskOrientation(0, reason === 'user' ? (normalized === 'reset' ? 3 : 2) : 1);
    hilog.info(RD_DOMAIN, RD_TAG, 'rustdeskFlipApplied reason=' + reason +
      ' mode=' + normalized +
      ' visualX=' + (state.visualFlipX ? '1' : '0') +
      ' visualY=' + (state.visualFlipY ? '1' : '0') +
      ' controlX=' + (state.controlFlipX ? '1' : '0') +
      ' controlY=' + (state.controlFlipY ? '1' : '0') +
      ' renderer=' + this.rendererHandle.toString() +
      ' transformVersion=' + this.rendererCanvasTransformPendingVersion.toString());
  }

  /** The read-only second canvas shares the host's visual correction, never its input axes. */
  private syncRustDeskMultiCanvasPreviewVisualTransform(reason: string): void {
    if (!this.rustDeskMultiCanvasPreview.active || this.sessionId <= 0 ||
      this.rustDeskMultiCanvasPreview.display < 0) {
      return;
    }
    const accepted: boolean = this.loader.setRustDeskMultiCanvasPreviewTransform(
      this.sessionId, this.rustDeskMultiCanvasPreview.display,
      this.canvasVisualFlipX, this.canvasVisualFlipY);
    hilog.info(RD_DOMAIN, RD_TAG, 'rustdeskFlipPreviewApplied reason=' + reason +
      ' display=' + this.rustDeskMultiCanvasPreview.display.toString() +
      ' visualX=' + (this.canvasVisualFlipX ? '1' : '0') +
      ' visualY=' + (this.canvasVisualFlipY ? '1' : '0') +
      ' accepted=' + (accepted ? '1' : '0'));
  }

  private restoreRustDeskDesktopFlipMode(host: RemoteHost, reason: string): void {
    const mode: RustDeskDesktopFlipMode = effectiveRustDeskDesktopFlipMode(
      host.rustdeskDesktopFlipMode, host.protocol, this.isDesktopDevice,
      host.rustdeskTargetDevice, this.rustDeskPeerPlatformCategory);
    this.adoptRustDeskDesktopFlipMode(mode, reason, false);
  }

  private setRustDeskDesktopFlipMode(mode: RustDeskDesktopFlipMode): void {
    const host: RemoteHost | null = this.pendingHost;
    const normalized: RustDeskDesktopFlipMode = normalizeRustDeskDesktopFlipMode(mode);
    if (host === null || host.protocol !== 'rustdesk' || !this.isDesktopDevice ||
      this.isRustDeskPhoneSession()) {
      promptAction.showToast({ message: '仅 PC 端 RustDesk 电脑会话支持画面翻转', duration: 1800 });
      return;
    }
    const existing: RemoteHost | undefined = this.srv.getHost(host.id);
    if (existing === undefined) {
      promptAction.showToast({ message: '主机记录不可用，画面翻转设置未保存', duration: 2000 });
      return;
    }
    const next: RemoteHost = existing.runtimeClone();
    next.rustdeskDesktopFlipMode = normalized;
    if (!this.srv.updateHost(next)) {
      hilog.warn(RD_DOMAIN, RD_TAG, 'rustdeskFlip persistence failed hostId=' +
        hashForLog(host.id) + ' mode=' + normalized);
      promptAction.showToast({ message: '本机主机设置保存失败，画面翻转未更改', duration: 2200 });
      return;
    }
    host.rustdeskDesktopFlipMode = normalized;
    this.resetRustDeskInputAfterGeometryChange('rustdesk-desktop-flip');
    this.adoptRustDeskDesktopFlipMode(normalized, 'user', true);
    hilog.info(RD_DOMAIN, RD_TAG, 'rustdeskFlip mode changed hostId=' +
      hashForLog(host.id) + ' mode=' + normalized + ' persisted=1');
    const message: string = normalized === 'reset' ? '画面与控制层已复位' : '翻转设置已更新';
    promptAction.showToast({ message, duration: 1500 });
  }

  /** PIP owns a fit-only renderer, but must retain the host's final visual correction. */
  private applyRustDeskDesktopFlipToPipRenderer(reason: string): void {
    if (!this.isRustDeskSession() || this.rendererHandle <= 0) { return; }
    const version: number = this.loader.setRendererCanvasTransform(
      this.rendererHandle, 1, 0, 0, this.canvasRotationQuarterTurns,
      this.canvasVisualFlipX, this.canvasVisualFlipY);
    if (Number.isFinite(version) && version > 0) {
      this.rendererCanvasTransformPendingVersion = version;
    }
    hilog.info(RD_DOMAIN, RD_TAG, 'rustdeskFlipApplied reason=' + reason +
      ' mode=' + this.rustDeskDesktopFlipMode +
      ' visualQ=' + this.canvasRotationQuarterTurns.toString() +
      ' controlQ=' + this.canvasControlRotationQuarterTurns.toString() +
      ' visualX=' + (this.canvasVisualFlipX ? '1' : '0') +
      ' visualY=' + (this.canvasVisualFlipY ? '1' : '0') +
      ' controlX=' + (this.canvasControlFlipX ? '1' : '0') +
      ' controlY=' + (this.canvasControlFlipY ? '1' : '0') +
      ' renderer=' + this.rendererHandle.toString() +
      ' transformVersion=' + this.rendererCanvasTransformPendingVersion.toString());
  }

  /** Rotate only the displayed RustDesk phone canvas; the peer keeps its native orientation. */
  private rotateRustDeskRemoteCanvas(): void {
    if (!this.isRustDeskPhoneSession()) {
      promptAction.showToast({ message: '仅控制手机模式支持旋转远端画面', duration: 1400 });
      return;
    }
    this.resetRustDeskInputAfterGeometryChange('rustdesk-canvas-rotation');
    this.canvasVisualFlipX = false;
    this.canvasVisualFlipY = false;
    this.canvasControlFlipX = false;
    this.canvasControlFlipY = false;
    this.canvasRotationQuarterTurns = (this.canvasRotationQuarterTurns + 1) % 4;
    this.canvasControlRotationQuarterTurns = this.canvasRotationQuarterTurns;
    this.resetCanvasToDisplayDefault(true);
    this.requestRemoteCursorViewRefresh(true);
    this.syncRemoteSystemPointer('rustdesk-canvas-rotation', this.remoteSurfaceHovered !== false, true);
    const angle: number = this.canvasRotationQuarterTurns * 90;
    promptAction.showToast({
      message: angle === 0 ? '远端画面已恢复原方向' : '远端画面已旋转 ' + angle.toString() + '°',
      duration: 1400
    });
  }

  private shouldUseRustDeskRemoteAppTouchScale(): boolean {
    if (this.isExplicitPhoneSession()) { return false; }
    return this.rustdeskRemoteAppTouchScaleEnabled && this.isRustDeskSession() &&
      this.connected && this.sessionId > 0;
  }

  private gestureCenterPoint(event: GestureEvent): LocalPoint | null {
    if (event.fingerList.length <= 0) {
      return null;
    }
    let sumX: number = 0;
    let sumY: number = 0;
    for (let index = 0; index < event.fingerList.length; index++) {
      sumX += event.fingerList[index].localX;
      sumY += event.fingerList[index].localY;
    }
    return {
      x: sumX / event.fingerList.length,
      y: sumY / event.fingerList.length,
      inside: true
    };
  }

  private startRustDeskRemoteAppTouchScale(event: GestureEvent): boolean {
    if (!this.shouldUseRustDeskRemoteAppTouchScale() || !this.canForwardInput('rustdesk-touch-scale')) {
      return false;
    }
    if (this.rustDeskTouchPinchActive) {
      // A parallel two-finger Pan may be recognized before Pinch. Reuse its
      // remote TouchPan stream instead of enqueueing a second start message.
      const transform: RemoteSurfaceTransform | null = this.rustDeskTouchPinchTransformSnapshot;
      const center: LocalPoint | null = this.gestureCenterPoint(event);
      if (transform === null || center === null) {
        return false;
      }
      const mapped: MappedPoint = this.mapInputPointWithTransform(center.x, center.y, transform);
      this.rustDeskTouchPanOnly = false;
      this.rustDeskTouchPinchLastScale = 1;
      this.rustDeskTouchPinchLastRemoteX = mapped.x;
      this.rustDeskTouchPinchLastRemoteY = mapped.y;
      return true;
    }
    const transform: RemoteSurfaceTransform = this.currentRemoteSurfaceTransform();
    const mapped: MappedPoint = this.mapInputPointWithTransform(
      event.pinchCenterX, event.pinchCenterY, transform);
    if (!this.loader.sendRustDeskTouchPan(this.sessionId, 0, mapped.x, mapped.y)) {
      hilog.warn(RD_DOMAIN, RD_TAG, 'rustdesk-touch-scale start rejected by native bridge');
      return false;
    }
    this.rustDeskTouchPinchActive = true;
    this.rustDeskTouchPinchLastScale = 1;
    this.rustDeskTouchPinchLastRemoteX = mapped.x;
    this.rustDeskTouchPinchLastRemoteY = mapped.y;
    this.rustDeskTouchPanOnly = false;
    this.rustDeskTouchPinchTransformSnapshot = transform;
    return true;
  }

  private startRustDeskRemoteAppTouchPanAt(point: LocalPoint): boolean {
    if (!this.shouldUseRustDeskRemoteAppTouchScale() || !this.canForwardInput('rustdesk-touch-pan')) {
      return false;
    }
    if (this.rustDeskTouchPinchActive) {
      return true;
    }
    const transform: RemoteSurfaceTransform = this.currentRemoteSurfaceTransform();
    const mapped: MappedPoint = this.mapInputPointWithTransform(point.x, point.y, transform);
    if (!this.loader.sendRustDeskTouchPan(this.sessionId, 0, mapped.x, mapped.y)) {
      hilog.warn(RD_DOMAIN, RD_TAG, 'rustdesk-touch-pan start rejected by native bridge');
      return false;
    }
    this.rustDeskTouchPinchActive = true;
    this.rustDeskTouchPanOnly = true;
    this.rustDeskTouchPinchLastScale = 1;
    this.rustDeskTouchPinchLastRemoteX = mapped.x;
    this.rustDeskTouchPinchLastRemoteY = mapped.y;
    this.rustDeskTouchPinchTransformSnapshot = transform;
    return true;
  }

  private startRustDeskRemoteAppTouchPan(event: GestureEvent): boolean {
    const center: LocalPoint | null = this.gestureCenterPoint(event);
    return center !== null && this.startRustDeskRemoteAppTouchPanAt(center);
  }

  private updateRustDeskRemoteAppTouchScale(event: GestureEvent): void {
    if (!this.rustDeskTouchPinchActive || !this.shouldUseRustDeskRemoteAppTouchScale()) {
      return;
    }
    const nextScale: number = Number.isFinite(event.scale) && event.scale > 0 ?
      event.scale : this.rustDeskTouchPinchLastScale;
    const transform: RemoteSurfaceTransform | null = this.rustDeskTouchPinchTransformSnapshot;
    if (transform === null) {
      this.releaseCanvasPinchInput('rustdesk-touch-scale-missing-transform');
      return;
    }
    const scaleDelta: number = rustDeskTouchScaleDelta(
      this.rustDeskTouchPinchLastScale, nextScale);
    if (scaleDelta !== 0 &&
      !this.loader.sendRustDeskTouchScale(this.sessionId, scaleDelta)) {
      this.releaseCanvasPinchInput('rustdesk-touch-scale-rejected');
      return;
    }
    const mapped: MappedPoint = this.mapInputPointWithTransform(
      event.pinchCenterX, event.pinchCenterY, transform);
    const deltaX: number = mapped.x - this.rustDeskTouchPinchLastRemoteX;
    const deltaY: number = mapped.y - this.rustDeskTouchPinchLastRemoteY;
    if (deltaX !== 0 || deltaY !== 0) {
      if (!this.loader.sendRustDeskTouchPan(this.sessionId, 1, deltaX, deltaY)) {
        this.releaseCanvasPinchInput('rustdesk-touch-pan-rejected');
        return;
      }
      this.rustDeskTouchPinchLastRemoteX = mapped.x;
      this.rustDeskTouchPinchLastRemoteY = mapped.y;
    }
    this.rustDeskTouchPinchLastScale = nextScale;
  }

  private updateRustDeskRemoteAppTouchPanAt(point: LocalPoint): void {
    if (!this.rustDeskTouchPinchActive || !this.rustDeskTouchPanOnly ||
      !this.shouldUseRustDeskRemoteAppTouchScale()) {
      return;
    }
    const transform: RemoteSurfaceTransform | null = this.rustDeskTouchPinchTransformSnapshot;
    if (transform === null) {
      this.releaseCanvasPinchInput('rustdesk-touch-pan-missing-transform');
      return;
    }
    const mapped: MappedPoint = this.mapInputPointWithTransform(point.x, point.y, transform);
    const deltaX: number = mapped.x - this.rustDeskTouchPinchLastRemoteX;
    const deltaY: number = mapped.y - this.rustDeskTouchPinchLastRemoteY;
    if (deltaX !== 0 || deltaY !== 0) {
      if (!this.loader.sendRustDeskTouchPan(this.sessionId, 1, deltaX, deltaY)) {
        this.releaseCanvasPinchInput('rustdesk-touch-pan-rejected');
        return;
      }
      this.rustDeskTouchPinchLastRemoteX = mapped.x;
      this.rustDeskTouchPinchLastRemoteY = mapped.y;
    }
  }

  private updateRustDeskRemoteAppTouchPan(event: GestureEvent): void {
    const center: LocalPoint | null = this.gestureCenterPoint(event);
    if (center === null) {
      this.releaseCanvasPinchInput('rustdesk-touch-pan-missing-transform');
      return;
    }
    this.updateRustDeskRemoteAppTouchPanAt(center);
  }

  private finishRustDeskRemoteAppTouchScale(): void {
    if (!this.rustDeskTouchPinchActive) {
      return;
    }
    if (this.sessionId > 0 && this.isRustDeskSession()) {
      if (!this.rustDeskTouchPanOnly) {
        this.loader.sendRustDeskTouchScale(this.sessionId, 0);
      }
      this.loader.sendRustDeskTouchPan(this.sessionId, 2,
        this.rustDeskTouchPinchLastRemoteX, this.rustDeskTouchPinchLastRemoteY);
    }
    this.rustDeskTouchPinchActive = false;
    this.rustDeskTouchPanOnly = false;
    this.rustDeskTouchPinchLastScale = 1;
    this.rustDeskTouchPinchTransformSnapshot = null;
  }

  private resetCanvasTwoFingerGesture(): void {
    this.canvasTwoFingerState = idleCanvasTwoFingerState();
    this.canvasTwoFingerLastMove = null;
  }

  private canUseCanvasTwoFingerGesture(): boolean {
    return this.canvasPanInteractionEnabledForCurrentProtocol() ||
      this.shouldUseRustDeskRemoteAppTouchScale();
  }

  private canPanCanvasForTwoFingerGesture(): boolean {
    if (!this.canUseCanvasTwoFingerGesture()) {
      return false;
    }
    if (this.shouldUseRustDeskRemoteAppTouchScale()) {
      // Remote-app touch pan is consumed by RustDesk, so it does not depend
      // on the local renderer's overflow state.
      return true;
    }
    if (!this.canvasPanInteractionEnabledForCurrentProtocol()) {
      return false;
    }
    if (!this.canvasTransformInitialized) {
      this.resetCanvasToDisplayDefault();
    }
    return canvasTransformCanPan(this.canvasTransform, this.currentCanvasViewport());
  }

  private beginCanvasTwoFingerCandidateAt(point: LocalPoint, span: number = 0): void {
    this.canvasTwoFingerSequence++;
    const remoteAppTarget: boolean = this.shouldUseRustDeskRemoteAppTouchScale();
    const zoomEnabled: boolean =
      this.canvasGestureZoomEnabledForCurrentProtocol() || remoteAppTarget;
    this.canvasTwoFingerState = beginCanvasTwoFingerCandidate(
      this.canvasTwoFingerSequence, point.x, point.y, Date.now(),
      zoomEnabled, this.canPanCanvasForTwoFingerGesture(), span);
  }

  /**
   * Observe the raw XComponent stream before the per-mode input handler. The
   * same owner is then visible to the ArkUI recognizers and to touchpad/RDP
   * forwarding, which prevents a vertical two-finger scroll from becoming a
   * local canvas pan halfway through one sequence.
   */
  private observeCanvasTwoFingerTouch(event: TouchEvent): void {
    this.canvasTwoFingerLastMove = null;
    if (event.sourceTool !== SourceTool.Finger) {
      return;
    }
    const activeCount: number = this.trackedCanvasTouchCount(event);
    if (event.type === TouchType.Down && activeCount >= 2 && this.touchFingerCount < 2) {
      const point: LocalPoint | null = this.averageTouchPoint(event) || this.primaryTouchPoint(event);
      if (point !== null) {
        this.beginCanvasTwoFingerCandidateAt(point, this.twoFingerTouchSpan(event));
      }
      return;
    }
    if (event.type === TouchType.Move && activeCount >= 2) {
      if (this.canvasTwoFingerState.owner === 'idle') {
        const point: LocalPoint | null = this.averageTouchPoint(event) || this.primaryTouchPoint(event);
        if (point !== null) {
          this.beginCanvasTwoFingerCandidateAt(point, this.twoFingerTouchSpan(event));
        }
      }
      const point: LocalPoint | null = this.averageTouchPoint(event) || this.primaryTouchPoint(event);
      if (point === null || this.canvasTwoFingerState.owner === 'idle') {
        return;
      }
      const result = advanceCanvasTwoFingerMove(
        this.canvasTwoFingerState, point.x, point.y, Date.now(),
        this.shouldUseRustDeskRemoteAppTouchScale(), this.twoFingerTouchSpan(event));
      this.canvasTwoFingerState = result.state;
      this.canvasTwoFingerLastMove = result;
      return;
    }
    if (event.type === TouchType.Cancel) {
      this.resetCanvasTwoFingerGesture();
    }
  }

  private finishCanvasTwoFingerCandidateForRelease(wasMoved: boolean): void {
    if (this.canvasTwoFingerState.owner !== 'candidate') {
      return;
    }
    this.canvasTwoFingerState = finishCanvasTwoFingerCandidate(
      this.canvasTwoFingerState, wasMoved);
  }

  private startCanvasPanFromPoint(point: LocalPoint): boolean {
    if (this.shouldUseRustDeskRemoteAppTouchScale()) {
      if (this.canvasTwoFingerState.owner !== 'remote-touch-pan' ||
        !this.startRustDeskRemoteAppTouchPanAt(point)) {
        this.resetCanvasTwoFingerGesture();
        return false;
      }
      this.canvasPanActive = true;
      this.canvasPanInputSource = 'touch';
      this.canvasPanLastOffsetX = point.x;
      this.canvasPanLastOffsetY = point.y;
      this.claimCanvasPinchInput();
      return true;
    }
    if (this.canvasTwoFingerState.owner !== 'canvas-pan' ||
      !this.canvasPanInteractionEnabledForCurrentProtocol()) {
      return false;
    }
    if (!this.canvasTransformInitialized) {
      this.resetCanvasToDisplayDefault();
    }
    const viewport: CanvasViewport = this.currentCanvasViewport();
    if (!canvasTransformCanPan(this.canvasTransform, viewport)) {
      return false;
    }
    this.captureCanvasGestureDensity(viewport);
    this.canvasPanActive = true;
    this.canvasPanInputSource = 'touch';
    this.canvasPanLastOffsetX = point.x;
    this.canvasPanLastOffsetY = point.y;
    if (!this.canvasPinchActive) {
      this.canvasPinchViewportSnapshot = viewport;
    }
    this.claimCanvasPinchInput();
    return true;
  }

  private updateCanvasPanFromPoint(x: number, y: number): void {
    if (!this.canvasPanActive || this.canvasPanInputSource !== 'touch') {
      return;
    }
    if (this.rustDeskTouchPinchActive) {
      if (this.canvasTwoFingerState.owner === 'remote-touch-pan') {
        this.canvasPanLastOffsetX = x;
        this.canvasPanLastOffsetY = y;
        this.updateRustDeskRemoteAppTouchPanAt({ x, y, inside: true });
      }
      return;
    }
    if (this.canvasTwoFingerState.owner !== 'canvas-pan') {
      return;
    }
    const viewport: CanvasViewport | null = this.canvasPinchViewportSnapshot;
    if (viewport === null) {
      this.releaseCanvasPinchInput('canvas-pan-missing-viewport');
      return;
    }
    const deltaX: number = this.canvasGestureVpToPx(x - this.canvasPanLastOffsetX);
    const deltaY: number = this.canvasGestureVpToPx(y - this.canvasPanLastOffsetY);
    this.canvasPanLastOffsetX = x;
    this.canvasPanLastOffsetY = y;
    if (deltaX === 0 && deltaY === 0) {
      return;
    }
    if (this.proRdpIncomingId) { this.cancelProRdpIncoming(); }
    this.canvasTransform = panCanvasTransform(this.canvasTransform, viewport, deltaX, deltaY);
    this.refreshCanvasTransformModified(viewport);
    this.applyCanvasTransform();
  }

  private startCanvasPinch(event: GestureEvent): void {
    if (this.canvasTwoFingerSuppressedUntilRelease || !this.canUseCanvasTwoFingerGesture()) {
      return;
    }
    if (this.canvasTwoFingerState.owner === 'idle') {
      const center: LocalPoint | null = this.gestureCenterPoint(event);
      if (center !== null) {
        this.beginCanvasTwoFingerCandidateAt(center);
      }
    }
    const remoteAppTarget: boolean = this.shouldUseRustDeskRemoteAppTouchScale();
    const claimed = claimCanvasTwoFingerPinch(this.canvasTwoFingerState, remoteAppTarget);
    if (claimed.owner === 'touchpad-right-click' || claimed.owner === 'canvas-pan' ||
      claimed.owner === 'remote-touch-pan' ||
      (this.canvasPinchActive &&
        (claimed.owner === 'canvas-pinch' || claimed.owner === 'remote-touch-scale'))) {
      return;
    }
    this.canvasTwoFingerState = claimed;
    if (remoteAppTarget) {
      if (this.startRustDeskRemoteAppTouchScale(event)) {
        // Remote scale owns the same gesture lifecycle as a local pinch. In
        // particular, overlay-only input has no raw TouchEvent drain to end
        // the remote TouchPan stream after PinchGesture finishes.
        this.canvasPinchActive = true;
        this.claimCanvasPinchInput();
      } else {
        this.resetCanvasTwoFingerGesture();
      }
      return;
    }
    if (!this.canvasGestureZoomEnabledForCurrentProtocol() ||
      this.canvasTwoFingerState.owner !== 'canvas-pinch') {
      return;
    }
    if (!this.canvasTransformInitialized) {
      this.resetCanvasToDisplayDefault();
    }
    const viewport: CanvasViewport = this.currentCanvasViewport();
    this.canvasPinchViewportSnapshot = viewport;
    this.captureCanvasGestureDensity(viewport);
    this.canvasPinchActive = true;
    this.canvasPinchLastScale = 1;
    this.canvasPinchLastCenterX = this.canvasGestureVpToPx(event.pinchCenterX);
    this.canvasPinchLastCenterY = this.canvasGestureVpToPx(event.pinchCenterY);
    this.claimCanvasPinchInput();
  }

  /** Two-finger pure translation is a local canvas gesture when content overflows. */
  private startCanvasPan(event: GestureEvent): void {
    if (this.canvasTwoFingerSuppressedUntilRelease || !this.canUseCanvasTwoFingerGesture() ||
      this.canvasPanActive ||
      this.canvasTwoFingerState.owner === 'touchpad-scroll' ||
      this.canvasTwoFingerState.owner === 'touchpad-right-click') {
      return;
    }
    if (this.canvasTwoFingerState.owner === 'idle') {
      const center: LocalPoint | null = this.gestureCenterPoint(event);
      if (center === null) {
        return;
      }
      this.beginCanvasTwoFingerCandidateAt(center);
      // API 23 devices can deliver the overlay PanGesture while bypassing the
      // raw TouchEvent observer. Leave one recognizer turn for PinchGesture to
      // claim span changes; a pure translation is claimed on the first update.
      return;
    }
    if (this.canvasTwoFingerState.owner === 'candidate') {
      const remoteAppTarget: boolean = this.shouldUseRustDeskRemoteAppTouchScale();
      this.canvasTwoFingerState = claimCanvasTwoFingerPan(this.canvasTwoFingerState, remoteAppTarget);
    }
    if (this.shouldUseRustDeskRemoteAppTouchScale()) {
      if (this.canvasTwoFingerState.owner !== 'remote-touch-pan') {
        return;
      }
      if (this.startRustDeskRemoteAppTouchPan(event)) {
        this.canvasPanActive = true;
        this.canvasPanInputSource = 'gesture';
        this.claimCanvasPinchInput();
      } else {
        this.resetCanvasTwoFingerGesture();
      }
      return;
    }
    if (this.canvasTwoFingerState.owner !== 'canvas-pan') {
      return;
    }
    if (!this.canvasTransformInitialized) {
      this.resetCanvasToDisplayDefault();
    }
    const viewport: CanvasViewport = this.currentCanvasViewport();
    if (!canvasTransformCanPan(this.canvasTransform, viewport)) {
      return;
    }
    this.captureCanvasGestureDensity(viewport);
    this.canvasPanActive = true;
    this.canvasPanInputSource = 'gesture';
    this.canvasPanLastOffsetX = Number.isFinite(event.offsetX) ? event.offsetX : 0;
    this.canvasPanLastOffsetY = Number.isFinite(event.offsetY) ? event.offsetY : 0;
    if (!this.canvasPinchActive) {
      this.canvasPinchViewportSnapshot = viewport;
    }
    this.claimCanvasPinchInput();
  }

  private updateCanvasPan(event: GestureEvent): void {
    if (!this.canvasPanActive &&
      (this.canvasTwoFingerState.owner === 'candidate' ||
        this.canvasTwoFingerState.owner === 'canvas-pan' ||
        this.canvasTwoFingerState.owner === 'remote-touch-pan')) {
      this.startCanvasPan(event);
    }
    if (!this.canvasPanActive || this.canvasPanInputSource !== 'gesture' ||
      !shouldApplyCanvasTwoFingerPan(this.canvasTwoFingerState)) {
      return;
    }
    if (this.rustDeskTouchPinchActive) {
      this.updateRustDeskRemoteAppTouchPan(event);
      return;
    }
    if (this.canvasPinchActive || !this.canvasPanInteractionEnabledForCurrentProtocol()) {
      return;
    }
    const offsetX: number = Number.isFinite(event.offsetX) ? event.offsetX : this.canvasPanLastOffsetX;
    const offsetY: number = Number.isFinite(event.offsetY) ? event.offsetY : this.canvasPanLastOffsetY;
    this.updateCanvasPanFromPoint(offsetX, offsetY);
  }

  private finishCanvasPan(): void {
    this.canvasPanActive = false;
    this.canvasPanInputSource = 'none';
    this.canvasPanLastOffsetX = 0;
    this.canvasPanLastOffsetY = 0;
    if (!this.canvasPinchActive) {
      this.canvasGesturePxPerVp = 1;
    }
  }

  private endCanvasPinchGesture(reason: string): void {
    if (!this.canvasPinchActive) {
      return;
    }
    // With a parallel two-finger recognizer, one recognizer can finish before
    // the other. Keep the shared ownership and viewport until both are done.
    const next = endCanvasPinchOwnership({
      pinchActive: this.canvasPinchActive,
      panActive: this.canvasPanActive
    });
    this.canvasPinchActive = next.pinchActive;
    this.canvasPinchLastScale = 1;
    if (shouldReleaseCanvasGestureOwnership(next)) {
      this.releaseCanvasPinchInput(reason);
    }
  }

  private endCanvasPanGesture(reason: string): void {
    if (!this.canvasPanActive || this.canvasPanInputSource !== 'gesture') {
      return;
    }
    const next = endCanvasPanOwnership({
      pinchActive: this.canvasPinchActive,
      panActive: this.canvasPanActive
    });
    this.finishCanvasPan();
    if (shouldReleaseCanvasGestureOwnership(next)) {
      this.releaseCanvasPinchInput(reason);
    }
  }

  /** Claim input only after ArkUI has recognized a real pinch, never on second-finger down. */
  private claimCanvasPinchInput(): void {
    if (this.canvasPinchInputPhase !== 'idle') {
      return;
    }
    const observedTouchCount: number = this.activeTouchPoints.size > 0 ?
      this.activeTouchPoints.size : this.touchFingerCount;
    const state = claimCanvasPinchTouchState(observedTouchCount);
    this.canvasPinchInputPhase = state.phase;
    this.canvasPinchTouchCount = state.fingerCount;
    this.clearTouchRightClickTimer();
    this.clearTouchDirectRightClickTimer();
    if (this.touchLeftDown) {
      this.sendMouseNow(this.remoteCursorX, this.remoteCursorY, 0, false);
      this.touchLeftDown = false;
    }
    this.touchDragActive = false;
    this.touchDragPending = false;
    this.touchGestureDone = true;
  }

  private updateCanvasPinch(event: GestureEvent): void {
    if (this.rustDeskTouchPinchActive) {
      this.updateRustDeskRemoteAppTouchScale(event);
      return;
    }
    if (!this.canvasPinchActive || !this.canvasGestureZoomEnabledForCurrentProtocol()) {
      return;
    }
    const viewport: CanvasViewport | null = this.canvasPinchViewportSnapshot;
    if (viewport === null) {
      this.releaseCanvasPinchInput('canvas-pinch-missing-viewport');
      return;
    }
    const nextScale: number = Number.isFinite(event.scale) && event.scale > 0 ? event.scale : this.canvasPinchLastScale;
    const centerX: number = this.canvasGestureVpToPx(event.pinchCenterX);
    const centerY: number = this.canvasGestureVpToPx(event.pinchCenterY);
    if (this.proRdpIncomingId) { this.cancelProRdpIncoming(); }
    this.canvasTransform = pinchCanvasTransform(this.canvasTransform, viewport,
      centerX, centerY, nextScale / this.canvasPinchLastScale,
      centerX - this.canvasPinchLastCenterX, centerY - this.canvasPinchLastCenterY);
    this.canvasPinchLastScale = nextScale;
    this.canvasPinchLastCenterX = centerX;
    this.canvasPinchLastCenterY = centerY;
    this.refreshCanvasTransformModified(viewport);
    this.applyCanvasTransform();
  }

  private finishCanvasPinch(): void {
    if (this.rustDeskTouchPinchActive) {
      this.finishRustDeskRemoteAppTouchScale();
    }
    this.canvasPinchActive = false;
    this.canvasPinchLastScale = 1;
    this.canvasPinchViewportSnapshot = null;
    this.rustDeskTouchPinchTransformSnapshot = null;
    if (!this.canvasPanActive) {
      this.canvasGesturePxPerVp = 1;
    }
  }

  /** Release gesture ownership from every terminal path; safe to call repeatedly. */
  private releaseCanvasPinchInput(reason: string): void {
    this.cancelExplicitPhoneInput();
    if (reason.indexOf('page-') === 0 || reason.indexOf('disconnect-') === 0 ||
      reason === 'zoom-setting-change') {
      this.clearPhysicalPointerCanvasFollow(true);
    }
    const wasActive: boolean = this.canvasPinchActive || this.rustDeskTouchPinchActive;
    const wasConsumed: boolean = this.canvasPinchInputPhase !== 'idle';
    this.finishCanvasPan();
    this.finishCanvasPinch();
    if (wasConsumed) {
      this.resetTouchGesture();
      if (shouldDrainCanvasPinchTouchSequence(reason)) {
        const state = drainCanvasPinchTouchState({
          phase: this.canvasPinchInputPhase,
          fingerCount: this.canvasPinchTouchCount
        });
        this.canvasPinchInputPhase = state.phase;
        this.canvasPinchTouchCount = state.fingerCount;
      } else {
        this.canvasPinchInputPhase = 'idle';
        this.canvasPinchTouchCount = 0;
      }
    }
    if (wasActive || wasConsumed) {
      hilog.info(RD_DOMAIN, RD_TAG, 'canvas-pinch-release reason=' + reason);
    }
    this.resetCanvasTwoFingerGesture();
  }

  private consumeCanvasPinchTouch(event: TouchEvent): boolean {
    // A raw-touch pan claims the same drain phase as a pinch to stop the
    // remote pointer path, but its local movement still has to be consumed by
    // the canvas transform before the event is swallowed.
    if (this.canvasPanActive && this.canvasPanInputSource === 'touch' &&
      event.sourceTool === SourceTool.Finger && event.type === TouchType.Move) {
      const point: LocalPoint | null = this.averageTouchPoint(event);
      if (point !== null) {
        this.updateCanvasPanFromPoint(point.x, point.y);
      }
      event.stopPropagation();
      return true;
    }
    if (!shouldConsumeCanvasPinchTouch(this.canvasPinchInputPhase !== 'idle',
      event.sourceTool === SourceTool.Finger)) {
      return false;
    }

    const eventType: CanvasPinchTouchEvent = event.type === TouchType.Down ? 'down' :
      event.type === TouchType.Up ? 'up' :
        event.type === TouchType.Cancel ? 'cancel' : 'move';
    const activeTouchCount: number = this.trackedCanvasTouchCount(event);
    if (shouldStartNewCanvasPinchTouchSequence(this.canvasPinchInputPhase, eventType,
      activeTouchCount, event.changedTouches.length)) {
      this.finishCanvasPinch();
      this.canvasPinchInputPhase = 'idle';
      this.canvasPinchTouchCount = 0;
      this.resetTouchGesture();
      return false;
    }

    const next = advanceCanvasPinchTouchState({
      phase: this.canvasPinchInputPhase,
      fingerCount: this.canvasPinchTouchCount
    }, eventType, activeTouchCount, event.changedTouches.length);
    this.canvasPinchInputPhase = next.phase;
    this.canvasPinchTouchCount = next.fingerCount;
    if (next.phase === 'idle') {
      this.finishCanvasPan();
      this.finishCanvasPinch();
      this.resetTouchGesture();
    }
    event.stopPropagation();
    return true;
  }

  private rustDeskViewScaleLabel(mode: string): string {
    if (mode === 'original') { return '原始尺寸'; }
    if (mode === 'custom') { return '自定义缩放'; }
    return '适应窗口';
  }

  private setRustDeskImageQualityPref(quality: number): void {
    const next: number = quality >= 0 && quality <= 2 ? quality : 1;
    this.rustdeskImageQuality = next;
    this.persistSessionPref('rustdeskImageQuality', next);
    this.stopRustDeskQualityConfirmation();
    const sessionId: number = this.sessionId;
    const live: boolean = sessionId >= 0 && this.isRustDeskSession();
    // Sample the remote target bitrate before the request so the verdict can
    // compare against what the peer was encoding with the previous tier.
    const baseline: RustDeskQualitySample | null = live ? this.rustDeskQualitySample(sessionId) : null;
    const appliedLive: boolean = live && this.loader.setRustDeskImageQuality(sessionId, next);
    recordRustDeskQualityRequest(sessionId, next, appliedLive,
      baseline !== null ? baseline.targetBitrateKbps : 0);
    if (!appliedLive || baseline === null) {
      promptAction.showToast({ message: '画质偏好已保存，下次连接生效', duration: 2000 });
      return;
    }
    promptAction.showToast({
      message: rustDeskQualityName(next) + '已发送，正在等待远端码率报告', duration: 2000
    });
    this.startRustDeskQualityConfirmation(sessionId, next, baseline);
  }

  /** Physical pixels per remote pixel from the last renderer viewport; -1 when unknown. */
  private remoteLocalScalePercent(): number {
    const viewport: RendererViewportSnapshot | null = this.rendererViewportCache;
    if (viewport === null || viewport.sourceWidth <= 0 || viewport.viewportW <= 0) { return -1; }
    const displayedSource: number = this.canvasRotationQuarterTurns % 2 === 1 ?
      viewport.sourceHeight : viewport.sourceWidth;
    if (displayedSource <= 0) { return -1; }
    return Math.max(1, Math.round(viewport.viewportW * 100 / displayedSource));
  }

  private rustDeskQualitySample(sessionId: number): RustDeskQualitySample | null {
    try {
      const snapshot: RustDeskDiagnosticsSnapshot = this.loader.getSessionDiagnostics(sessionId);
      if (snapshot.sessionId !== sessionId) { return null; }
      return {
        sessionActive: snapshot.sessionActive,
        targetBitrateKbps: snapshot.targetBitrateKbps,
        testDelayCount: snapshot.testDelayCount,
        sentImageQuality: snapshot.sentImageQuality,
        qualityRequestedGeneration: snapshot.qualityRequestedGeneration,
        qualityAppliedGeneration: snapshot.qualityAppliedGeneration,
        qualityUpdateStatus: snapshot.qualityUpdateStatus
      };
    } catch (_e) {
      return null;
    }
  }

  private startRustDeskQualityConfirmation(sessionId: number, quality: number,
    baseline: RustDeskQualitySample): void {
    const state: RustDeskQualityConfirmation =
      beginRustDeskQualityConfirmation(quality, Date.now(), baseline);
    this.rustDeskQualityConfirmation = state;
    this.rustDeskQualityConfirmSessionId = sessionId;
    this.rustDeskQualityConfirmTimer = setInterval((): void => {
      if (this.rustDeskQualityConfirmation !== state) { return; }
      if (!this.connected || this.sessionId !== sessionId || !this.isRustDeskSession()) {
        this.stopRustDeskQualityConfirmation();
        return;
      }
      const sample: RustDeskQualitySample | null = this.rustDeskQualitySample(sessionId);
      if (sample === null) { return; }
      const nowMs: number = Date.now();
      const evaluation: RustDeskQualityEvaluation =
        evaluateRustDeskQualityConfirmation(state, sample, nowMs);
      if (!rustDeskQualityVerdictIsFinal(evaluation.verdict)) { return; }
      this.stopRustDeskQualityConfirmation(false);
      recordRustDeskQualityResult(sessionId, quality, evaluation.verdict,
        evaluation.currentBitrateKbps, nowMs - state.startedAtMs);
      promptAction.showToast({
        message: rustDeskQualityVerdictMessage(quality, evaluation), duration: 3000
      });
    }, RUSTDESK_QUALITY_POLL_INTERVAL_MS);
  }

  /**
   * Stops the pending confirmation. A request stopped before its verdict
   * (newer tier, disconnect, session change, page exit) is recorded as
   * superseded so the capture does not show it as an open, unconfirmed change.
   */
  private stopRustDeskQualityConfirmation(recordSuperseded: boolean = true): void {
    if (this.rustDeskQualityConfirmTimer >= 0) {
      clearInterval(this.rustDeskQualityConfirmTimer);
      this.rustDeskQualityConfirmTimer = -1;
    }
    const pending: RustDeskQualityConfirmation | null = this.rustDeskQualityConfirmation;
    this.rustDeskQualityConfirmation = null;
    if (pending !== null && recordSuperseded) {
      recordRustDeskQualityResult(this.rustDeskQualityConfirmSessionId, pending.quality, 'superseded', 0,
        Date.now() - pending.startedAtMs);
    }
    this.rustDeskQualityConfirmSessionId = -1;
  }

