      let sessionPort: number = rustDeskEndpoint === null ? host.port : rustDeskEndpoint.port;
      if (host.protocol === 'rdp' && this.rdpTransportHostOverride !== '') {
        sessionHost = this.rdpTransportHostOverride;
      }
