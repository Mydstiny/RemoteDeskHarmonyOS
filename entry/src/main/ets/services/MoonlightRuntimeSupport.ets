import { cryptoFramework } from '@kit.CryptoArchitectureKit';
import { util } from '@kit.ArkTS';

function sha256Hex(value: string): string {
  const md = cryptoFramework.createMd('SHA256');
  md.updateSync({ data: new util.TextEncoder().encode(value) });
  const bytes: Uint8Array = md.digestSync().data;
  let result: string = '';
  for (let index = 0; index < bytes.length; index++) {
    result += bytes[index].toString(16).padStart(2, '0');
  }
  return result;
}

/** Native receives only a one-way scope fingerprint, never the raw owner id. */
export function moonlightOwnerScopeFingerprint(ownerScopeId: string): string {
  const normalized: string = ownerScopeId.trim();
  return sha256Hex('RemoteDeskHarmonyOS:moonlight-owner:v1:' + normalized);
}

/** Stable local installation identity for the current physical store. */
export function moonlightInstallationId(storeIdentity: string): string {
  return 'moonlight-install-' + sha256Hex(
    'RemoteDeskHarmonyOS:moonlight-installation:v1:' + storeIdentity.trim());
}

/** One-way physical-store binding used only by device-local recovery state. */
export function moonlightStoreIdentityHash(storeIdentity: string): string {
  const normalized: string = storeIdentity.trim();
  return normalized.length === 0 ? '' : sha256Hex(
    'RemoteDeskHarmonyOS:moonlight-recovery-store:v1:' + normalized);
}

/** Short, non-reversible owner label for local recovery diagnostics and keys. */
export function moonlightOwnerScopeShortId(ownerScopeId: string): string {
  const normalized: string = ownerScopeId.trim();
  return normalized.length === 0 ? '' :
    moonlightOwnerScopeFingerprint(normalized).slice(0, 16);
}

/** Opaque local correlation id. It is not a native session id or credential. */
export function moonlightSessionRecoveryId(): string {
  const bytes: Uint8Array = cryptoFramework.createRandom().generateRandomSync(16).data;
  let result: string = '';
  for (let index: number = 0; index < bytes.length; index++) {
    result += bytes[index].toString(16).padStart(2, '0');
  }
  bytes.fill(0);
  return result;
}

/** Four decimal digits generated by the platform CSPRNG for Sunshine pairing. */
export function moonlightPairingPin(): string {
  const bytes: Uint8Array = cryptoFramework.createRandom().generateRandomSync(2).data;
  const value: number = ((bytes[0] << 8) | bytes[1]) % 10000;
  bytes.fill(0);
  return value.toString().padStart(4, '0');
}
